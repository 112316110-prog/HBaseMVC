<!-- ══════════════ SCRIPTS ══════════════ -->
<script>
function showAddPage(pageNumber) {

    const pages =
        document.querySelectorAll(
            '.add-form-page'
        );

    if (!pages.length) {
        console.error(
            '找不到新增資料頁面'
        );
        return;
    }

    pages.forEach(function (page) {
        page.classList.remove('active');
    });

    const targetPage =
        document.getElementById(
            `add-form-page-${pageNumber}`
        );

    if (!targetPage) {
        console.error(
            `找不到第 ${pageNumber} 頁`
        );
        return;
    }

    targetPage.classList.add('active');

    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    });
}

    /* ── Panel switching ── */
    function showPanel(id, navEl) {
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        document.getElementById(id).classList.add('active');
        if (navEl) navEl.classList.add('active');
if (id === 'panel-add') {

    const currentAddPage =
        @addPage;

    showAddPage(currentAddPage);
}
    }

    /* ── Open upload panel for specific row ── */
    function openUpload(row) {
    document.querySelectorAll('.upload-card').forEach(c => c.style.display = 'none');
    const card = document.getElementById('upload_' + row);
    if (card) card.style.display = 'block';
    document.getElementById('upload-target-label').textContent = row;
    showPanel('panel-upload', document.getElementById('nav-upload'));
}

    /* ── Delete confirm ── */
    function openConfirm(row) {
    document.getElementById('confirm-row').value = row;
    document.getElementById('confirm-name').textContent = row;
    document.getElementById('confirm-overlay').classList.add('open');
}
    function closeConfirm() {
