        <!-- ────────────── PANEL: 資料列表 ────────────── -->
 <section class="panel" id="panel-list">

    <div class="panel-header">
        <span class="panel-title">資料列表</span>
        <span class="panel-sub">
            @(Model != null ? Model.Count : 0) 筆記錄
        </span>

        <div style="flex:1;"></div>

        @if (isTeacher)
        {
            <button class="btn btn-primary btn-sm"
                    onclick="showPanel('panel-add', document.querySelector('[onclick*=panel-add]'))">
                ＋ 新增資料
            </button>
        }
    </div>

    <div class="card">
        @if (!hasData)
        {
            <div class="empty-state">
                <div class="empty-state-icon">⚕</div>
                <div class="empty-state-title">尚無病人資料</div>
                <div class="empty-state-sub">
                    @(isTeacher ? "請點擊左側「新增資料」開始建立" : "目前尚無可瀏覽資料")
                </div>
            </div>
        }
        else
        {
            <div class="tbl-wrap">
                <table>
                                <thead>
                                    <tr>
                                        <th>病人編號</th>
                                        <th>病歷號碼</th>
                                        <th>性別</th>
                                        <th>血型</th>
                                        <th>圖片</th>
                                        <th>影片</th>
                                        <th>功能</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="td-key">
                                                @item.RowKey
                                            </td>

                                            <td>
                                                @item.MedicalRecordNumber
                                            </td>

                                            <td>
                                                @item.Gender
                                            </td>

                                            <td>
                                                @item.BloodType
                                            </td>

                                            <td>
                                                <span class="badge badge-count">
                                                    @(
    (item.ImagePaths?.Count ?? 0)
    +
    (item.MedicalImagePaths?.Count ?? 0)
)
                                                </span>
                                            </td>

                                            <td>
                                                <span class="badge badge-count">
                                                    @item.VideoPaths.Count
                                                </span>
                                            </td>

                                            <td>
                                                <div class="table-actions">

                                                    <a class="btn btn-xs btn-info"
                                                       href="@Url.Action(
                                                                      "Image",
                                                                      "Home",
                                                                      new { row = item.RowKey }
                                                                  )">
                                                        病理影像
                                                    </a>

                                                    <a class="btn btn-xs btn-success"
                                                       href="@Url.Action(
                                                                      "Image",
                                                                      "Home",
                                                                      new { row = item.RowKey }
                                                                  )#video-section">
                                                        解剖影片
                                                    </a>

                                                    <a class="btn btn-xs btn-info"
                                                       href="@Url.Action(
                                                                      "MedicalRecords",
                                                                      "Home",
                                                                      new { row = item.RowKey }
                                                                  )">
                                                        病歷
                                                    </a>

                                                    @if (isTeacher)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-xs"
                                                                onclick="openUpload('@item.RowKey')">
                                                            上傳圖片／影片
                                                        </button>

                                                        <a class="btn btn-xs"
                                                           href="@Url.Action(
                                                                              "Index",
                                                                              "Home",
                                                                              new { row = item.RowKey }
                                                                          )">
                                                            修改
                                                        </a>
                                                    }

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
            </div>
        }
    </div>
</section>

