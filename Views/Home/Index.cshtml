                }
            });
        });
    });

    /* ══ Canvas annotation logic ══ */
    let drawMode = {};
    let canvasReady = {};

    function initCanvas(i) {
        const canvas = document.getElementById('canvas_' + i);
        const img    = document.getElementById('img_' + i);
        if (!canvas || !img) return;

        const ctx = canvas.getContext('2d');
        drawMode[i]   = false;
        canvasReady[i] = false;
        canvas.style.pointerEvents = 'auto';
canvas.style.cursor = 'crosshair';
        function resizeCanvasToImage() {
            const rect = img.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return false;
            canvas.width  = rect.width;
            canvas.height = rect.height;
            canvas.style.width  = rect.width  + 'px';
            canvas.style.height = rect.height + 'px';
            canvas.style.left = '0px';
            canvas.style.top  = '0px';
            canvasReady[i] = true;
            return true;
        }

        function doResize() {
            if (!resizeCanvasToImage()) setTimeout(doResize, 100);
        }

        if (img.complete) doResize();
        else img.onload = doResize;
        window.addEventListener('resize', doResize);
       
        let drawing = false, lastX = 0, lastY = 0;

        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            return { x: e.clientX - rect.left, y: e.clientY - rect.top };
        }

        canvas.addEventListener('mousedown', function(e) {
            if (!drawMode[i] || !canvasReady[i]) return;
            drawing = true;
            const p = getPos(e); lastX = p.x; lastY = p.y;
            e.preventDefault();
        });
        canvas.addEventListener('mousemove', function(e) {
            if (!drawing || !drawMode[i] || !canvasReady[i]) return;
            const p = getPos(e);
            ctx.beginPath();
            ctx.moveTo(lastX, lastY);
            ctx.lineTo(p.x, p.y);
            ctx.strokeStyle = '#e8b84b';
            ctx.lineWidth   = 2.5;
            ctx.lineCap     = 'round';
            ctx.lineJoin    = 'round';
            ctx.stroke();
            lastX = p.x; lastY = p.y;
            e.preventDefault();
        });
        canvas.addEventListener('mouseup',    function() { drawing = false; });
        canvas.addEventListener('mouseleave', function() { drawing = false; });
    }

    function toggleDraw(i) {
        const canvas = document.getElementById('canvas_' + i);
        const btn    = document.getElementById('drawbtn_' + i);
        if (!canvas) return;
        drawMode[i] = !drawMode[i];
        if (drawMode[i]) {
            canvas.style.pointerEvents = 'auto';
            canvas.style.cursor = 'crosshair';
            if (btn) { btn.textContent = '停止畫圖'; btn.style.borderColor = 'var(--accent)'; btn.style.color = 'var(--accent)'; }
        } else {
            canvas.style.pointerEvents = 'none';
            canvas.style.cursor = 'default';
            if (btn) { btn.textContent = '✏ 開始畫圖'; btn.style.borderColor = ''; btn.style.color = ''; }
        }
    }

    function clearCanvas(i) {
        const canvas = document.getElementById('canvas_' + i);
        if (!canvas) return;
        canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
    }

    function addText(i) {
        const canvas  = document.getElementById('canvas_' + i);
        const textBox = document.getElementById('text_' + i);
        if (!canvas || !textBox) return;
        const text = textBox.value.trim();
        if (!text) return;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#e8b84b';
        ctx.font = 'bold 15px "Noto Sans TC", sans-serif';
        ctx.fillText(text, 14, 28);
        textBox.value = '';
    }

    async function saveAnno(row, imagePath, i) {
        const canvas = document.getElementById('canvas_' + i);
        if (!canvas) return;
        const base64 = canvas.toDataURL('image/png');
        await fetch('/Home/SaveAnnotation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body:
                'row='   + encodeURIComponent(row) +
                '&imagePath=' + encodeURIComponent(imagePath) +
                '&jsonData=' +
                '&annotatedImageBase64=' + encodeURIComponent(base64)
        });
        const btn = document.querySelector('[onclick="saveAnno(\'' + row + '\',\'' + imagePath + '\',' + i + ')"]');
        if (btn) {
            const orig = btn.textContent;
            btn.textContent = '✔ 已儲存';
            btn.style.borderColor = 'var(--success)';
            btn.style.color = '#5cb88a';
            setTimeout(() => { btn.textContent = orig; btn.style.borderColor = ''; btn.style.color = ''; }, 2000);
        }
    }

    /* init all canvases on load */
    document.addEventListener('DOMContentLoaded', function() {
        const count = @((ViewBag.ImagePaths as List<string> ?? new List<string>()).Count);
        for (let i = 0; i < count; i++) initCanvas(i);
    });

        /* ══ AI Assistant ══ */

        let aiConversation = [];
        let importedMedicalRecord = '';
        let importedMedicalRecordName = '';

        async function importMedicalRecord() {
        const fileInput =
        document.getElementById('medical-record-file');

        const importButton =
        document.getElementById('medical-record-import-button');

        const statusElement =
        document.getElementById('medical-record-status');

        const previewElement =
        document.getElementById('medical-record-preview');

        const file =
        fileInput.files && fileInput.files.length > 0
        ? fileInput.files[0]
        : null;

        if (!file) {
        statusElement.textContent = '請先選擇電子病歷檔案。';
        statusElement.className = 'ai-record-status error';
        fileInput.focus();
        return;
        }

        const allowedExtensions = [
        '.txt',
        '.csv',
        '.json'
        ];

        const fileName =
        file.name.toLowerCase();

        const isAllowed =
        allowedExtensions.some(
        extension => fileName.endsWith(extension)
        );

        if (!isAllowed) {
        statusElement.textContent =
        '目前只支援 TXT、CSV、JSON 檔案。';

        statusElement.className =
        'ai-record-status error';

        fileInput.value = '';
        return;
        }

        const maxFileSize =
        2 * 1024 * 1024;

        if (file.size > maxFileSize) {
        statusElement.textContent =
        '檔案不可超過 2 MB。';

        statusElement.className =
        'ai-record-status error';

        fileInput.value = '';
        return;
        }

        const formData =
        new FormData();

        formData.append(
        'medicalRecordFile',
        file
        );

        importButton.disabled = true;

        statusElement.textContent =
        '正在讀取電子病歷檔案...';

        statusElement.className =
        'ai-record-status';

        previewElement.classList.remove('open');
        previewElement.textContent = '';

        try {
        const response =
        await fetch(
        '/Home/ImportMedicalRecord',
        {
        method: 'POST',

        headers: {
        'RequestVerificationToken':
        getAntiForgeryToken()
        },

        body: formData
        }
        );

        let data;

        try {
        data = await response.json();
        } catch {
        throw new Error(
        '伺服器回傳格式錯誤。'
        );
        }

        if (!response.ok) {
        let errorMessage =
        data.error ||
        '電子病歷匯入失敗。';

        if (data.detail) {
        errorMessage +=
        `\n詳細原因：${data.detail}`;
        }

        throw new Error(errorMessage);
        }

        if (!data.success) {
        throw new Error(
        data.error ||
        '電子病歷匯入失敗。'
        );
        }

        statusElement.textContent =
        data.message ||
        `病人資料 ${data.row} 已成功匯入。`;

        statusElement.className =
        'ai-record-status success';

        previewElement.textContent =
        `病人編號：${data.row}\n電子病歷已新增至正式資料列表。`;

        previewElement.classList.add('open');

        appendAiMessage(
        'system',
        `電子病歷 ${data.row} 已成功新增至正式資料列表。`
        );

        fileInput.value = '';

        setTimeout(function () {
        window.location.href = '/Home/Index';
        }, 1000);

        return;
        } catch (error) {
        importedMedicalRecord = '';
        importedMedicalRecordName = '';

        statusElement.textContent =
        error.message ||
        '電子病歷匯入失敗。';

        statusElement.className =
        'ai-record-status error';
        } finally {
        importButton.disabled = false;
        }
        }

        function clearMedicalRecord() {
        importedMedicalRecord = '';
        importedMedicalRecordName = '';

        const fileInput =
        document.getElementById('medical-record-file');

        const statusElement =
        document.getElementById('medical-record-status');

        const previewElement =
        document.getElementById('medical-record-preview');

        if (fileInput) {
        fileInput.value = '';
        }

        if (previewElement) {
        previewElement.textContent = '';
        previewElement.classList.remove('open');
        }

        if (statusElement) {
        statusElement.textContent =
        '尚未匯入電子病歷。支援 TXT、CSV、JSON，檔案大小上限 2 MB。';

        statusElement.className =
        'ai-record-status';
        }
        }

        async function askAi() {
        const questionInput = document.getElementById('ai-question');
        const sendButton = document.getElementById('ai-send-button');
        const statusElement = document.getElementById('ai-status');

        const question =
        questionInput.value.trim();

        if (!question && !importedMedicalRecord) {
        statusElement.textContent =
        '請輸入問題，或先匯入電子病歷檔案。';

        statusElement.classList.add('ai-error');
        questionInput.focus();
        return;
        }

        if (question.length > 3000) {
        statusElement.textContent = '問題不可超過 3000 個字元。';
        statusElement.classList.add('ai-error');
        return;
        }

        statusElement.classList.remove('ai-error');
        statusElement.textContent = 'AI 正在產生回答...';

        sendButton.disabled = true;
        questionInput.disabled = true;

        let questionForAi = question;

        if (!questionForAi) {
        questionForAi =
        '請整理這份電子病歷的主要病史、診斷、檢驗異常及重要教學重點。';
        }

        let messageForAi = questionForAi;

        if (importedMedicalRecord) {
        messageForAi =
        `以下為使用者匯入的電子病歷檔案。

        檔案名稱：
        ${importedMedicalRecordName}

        電子病歷內容：
        ${importedMedicalRecord}

        使用者問題：
        ${questionForAi}`;
        }

        appendAiMessage(
        'user',
        importedMedicalRecord
        ? `${questionForAi}\n\n已附加電子病歷：${importedMedicalRecordName}`
        : questionForAi
        );

        questionInput.value = '';

        aiConversation.push({
        role: 'user',
        content: messageForAi
        });

        try {
        const response = await fetch('/Home/AskAi', {
        method: 'POST',
        headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getAntiForgeryToken()
        },
        body: JSON.stringify({
        messages: aiConversation
        })
        });

        let data;

        try {
        data = await response.json();
        } catch {
        throw new Error('伺服器回傳格式錯誤。');
        }

        if (!response.ok) {
        throw new Error(
        data.error ||
        data.detail ||
        `AI 服務錯誤：HTTP ${response.status}`
        );
        }

        const answer = data.answer || '模型沒有回傳回答。';

        appendAiMessage('assistant', answer);

        aiConversation.push({
        role: 'assistant',
        content: answer
        });

        trimAiConversation();

        statusElement.textContent = '';
        } catch (error) {
        console.error(error);

        appendAiMessage(
        'assistant',
        '目前無法取得 AI 回答，請稍後再試。'
        );

        statusElement.textContent = error.message;
        statusElement.classList.add('ai-error');

        // 呼叫失敗時，移除最後一筆 user message，
        // 避免重送時對話歷史不一致
        if (
        aiConversation.length > 0 &&
        aiConversation[aiConversation.length - 1].role === 'user'
        ) {
        aiConversation.pop();
        }
        } finally {
        sendButton.disabled = false;
        questionInput.disabled = false;
        questionInput.focus();
        }
        }

        function appendAiMessage(role, content) {
        const chatBox = document.getElementById('ai-chat-box');

        const messageElement = document.createElement('div');
        messageElement.className = `ai-message ${role}`;

        const bubbleElement = document.createElement('div');
        bubbleElement.className = 'ai-bubble';

        // 必須用 textContent，避免模型輸出的 HTML 被瀏覽器執行
        bubbleElement.textContent = content;

        messageElement.appendChild(bubbleElement);
        chatBox.appendChild(messageElement);

        chatBox.scrollTop = chatBox.scrollHeight;
        }

        function clearAiChat() {
        aiConversation = [];

        clearMedicalRecord();

        const questionInput =
        document.getElementById('ai-question');

        const chatBox =
        document.getElementById('ai-chat-box');

        if (questionInput) {
        questionInput.value = '';
        }

        chatBox.innerHTML = '';

        appendAiMessage(
        'system',
        '對話與已匯入的電子病歷已清除。可重新輸入問題或上傳病歷檔案。'
        );

        const statusElement =
        document.getElementById('ai-status');

        statusElement.textContent = '';
        statusElement.classList.remove('ai-error');
        }

        function trimAiConversation() {
        const maxMessages = 12;

        if (aiConversation.length > maxMessages) {
        aiConversation =
        aiConversation.slice(aiConversation.length - maxMessages);
        }
        }

        function getAntiForgeryToken() {
        const tokenInput =
        document.querySelector(
        'input[name="__RequestVerificationToken"]'
        );

        return tokenInput ? tokenInput.value : '';
        }

        document.addEventListener('DOMContentLoaded', function () {
        const questionInput = document.getElementById('ai-question');

        if (!questionInput) {
        return;
        }

        questionInput.addEventListener('keydown', function (event) {
        if (
        event.key === 'Enter' &&
        !event.shiftKey
        ) {
        event.preventDefault();
        askAi();
        }
        });
        });

</script>
