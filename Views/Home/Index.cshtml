        /* ───── 新增資料分頁 ───── */
.add-form-page {
    display: none;
}

.add-form-page.active {
    display: block;
}

.add-page-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 18px;
}

/* ===== 新增資料步驟導覽 ===== */

.add-stepper {
    max-width: 900px;
    display: flex;
    align-items: center;
    margin-bottom: 24px;
    padding: 4px 0;
}

.add-step {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text3);
    white-space: nowrap;
}

.add-step-number {
    width: 30px;
    height: 30px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid var(--border2);
    border-radius: 50%;

    background: var(--bg2);
    color: var(--text2);

    font-size: 13px;
    font-weight: 600;
}

.add-step-label {
    font-size: 14px;
    font-weight: 500;
}

.add-step-line {
    flex: 1;
    height: 1px;
    min-width: 15px;

    margin: 0 10px;

    background: var(--border2);
}

/* 目前所在頁 */
.add-step.active {
    color: var(--accent);
}

.add-step.active .add-step-number {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
}

/* 已經經過的頁面 */
.add-step.done {
    color: var(--text2);
}

.add-step.done .add-step-number {
    background: var(--text);
    border-color: var(--text);
    color: white;
}

/* 小螢幕 */
@@media (max-width: 900px) {

    .add-stepper {
        overflow-x: auto;
        padding-bottom: 8px;
    }

    .add-step-line {
        min-width: 25px;
    }
}
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

