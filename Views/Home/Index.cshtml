            font-size: 15px;
            font-weight: 600;
            color: var(--accent);
        }
        .modal-body { padding: 20px; }
        .modal-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .modal-form-grid .full { grid-column: 1 / -1; }
        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 14px 20px;
            border-top: 1px solid var(--border);
        }

        /* ───── Delete confirm ───── */
        .confirm-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        .confirm-overlay.open { display: flex; }
        .confirm-box {
            background: var(--bg2);
            border: 1px solid var(--border2);
            border-radius: var(--radius-lg);
            padding: 28px 28px 20px;
            width: 340px;
            text-align: center;
        }
        .confirm-box p { color: var(--text2); font-size: 14px; margin-bottom: 20px; }
        .confirm-box strong { color: var(--accent); }

        /* ───── Scrollbar ───── */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }

        /* ───── Responsive ───── */
        @@media (max-width: 768px) {
            .shell { grid-template-columns: 1fr; }
            .sidebar { display: none; }
            .upload-grid { grid-template-columns: 1fr; }
            .img-row { grid-template-columns: 1fr; }
        }

/* 全域字體 */
body {
    font-size: 18px !important;
}

/* 標題 */
.panel-title {
    font-size: 30px !important;
}

.card-title {
    font-size: 30px !important;
}

/* 按鈕 */
.btn {
    font-size: 18px !important;
}

/* ===== 表格優化 ===== */
table {
    font-size: 18px !important;
    background: #ffffff;
    border-radius: 6px;
    overflow: hidden;
}

/* 表頭 */
thead th {
    padding: 12px 18px !important;
    font-size: 18px !important;
    font-weight: 600 !important;
    color: #374151 !important;
    background: #f1f5f9 !important;
    border-bottom: 2px solid #cbd5e1 !important;
}

/* 表格內容 */
tbody td {
    padding: 14px 14px !important;
    color: #1f2937 !important;
}

/* hover */
tbody tr:hover td {
    background: #dbeafe !important;
    color: #1e3a8a !important;
}

/* 關鍵欄位 */
.td-key {
    font-size: 15px !important;
    font-weight: 600;
}

/* 行距 */
td, th {
    line-height: 1.8;
}
.notes-tbl {
    min-width: 0 !important;
}

            /* ───── AI Assistant ───── */
            .ai-layout {
                display: grid;
                grid-template-rows: minmax(360px, 1fr) auto;
                gap: 14px;
                max-width: 960px;
            }

            .ai-chat-box {
                min-height: 420px;
                max-height: 620px;
                overflow-y: auto;
                padding: 18px;
                background: var(--bg3);
                border: 1px solid var(--border);
                border-radius: 8px;
            }

            .ai-message {
                display: flex;
                margin-bottom: 14px;
            }

                .ai-message.user {
                    justify-content: flex-end;
                }

                .ai-message.assistant {
                    justify-content: flex-start;
                }

            .ai-bubble {
                max-width: 82%;
                padding: 12px 16px;
                border-radius: 10px;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
                line-height: 1.7;
                font-size: 16px;
            }

            .ai-message.user .ai-bubble {
                background: var(--accent);
                color: white;
                border-bottom-right-radius: 3px;
            }

            .ai-message.assistant .ai-bubble {
                background: white;
                color: var(--text);
                border: 1px solid var(--border);
                border-bottom-left-radius: 3px;
            }

            .ai-message.system .ai-bubble {
                max-width: 100%;
                background: var(--info-bg);
                color: var(--text2);
                border: 1px solid rgba(59, 130, 246, 0.2);
            }

            .ai-input-area {
                display: grid;
                grid-template-columns: 1fr auto;
                gap: 10px;
                align-items: end;
            }

                .ai-input-area textarea {
                    width: 100%;
                    min-height: 90px;
                    max-height: 180px;
                    resize: vertical;
                    padding: 12px;
                    background: white;
                    border: 1px solid var(--border2);
                    border-radius: 7px;
                    color: var(--text);
                    font: inherit;
                    outline: none;
                }

                    .ai-input-area textarea:focus {
                        border-color: var(--accent);
                    }

            .ai-send-button {
                height: 44px;
                min-width: 100px;
            }

            .ai-status {
                min-height: 24px;
                margin-top: 8px;
                color: var(--text3);
                font-size: 13px;
            }

            .ai-error {
                color: var(--red);
            }

            .ai-record-import {
                margin-bottom: 14px;
                padding: 14px;
                border: 1px dashed var(--border2);
                border-radius: 8px;
                background: #ffffff;
            }

            .ai-record-title {
                margin-bottom: 8px;
                color: var(--text);
                font-size: 15px;
                font-weight: 500;
            }

            .ai-record-row {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 10px;
            }

            .ai-record-file {
                flex: 1;
                min-width: 220px;
                padding: 8px;
                border: 1px solid var(--border2);
                border-radius: 6px;
                background: var(--bg3);
                color: var(--text);
                font-family: inherit;
                font-size: 14px;
            }

            .ai-record-status {
                margin-top: 9px;
                color: var(--text3);
                font-size: 13px;
                line-height: 1.6;
            }

                .ai-record-status.success {
                    color: var(--success);
                }

                .ai-record-status.error {
                    color: var(--red);
                }

            .ai-record-preview {
                display: none;
                width: 100%;
                min-height: 120px;
                max-height: 250px;
                margin-top: 10px;
                padding: 12px;
                overflow-y: auto;
                border: 1px solid var(--border);
                border-radius: 7px;
                background: var(--bg3);
                color: var(--text2);
                font-family: inherit;
                font-size: 13px;
                line-height: 1.7;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }

                .ai-record-preview.open {
                    display: block;
                }

            @@media (max-width: 768px) {
                .ai-record-row {
                    align-items: stretch;
                    flex-direction: column;
                }

                .ai-record-file {
                    width: 100%;
                    min-width: 0;
                }

                .ai-record-row .btn {
                    width: 100%;
                }
            }

            @@media (max-width: 768px) {
                .ai-input-area {
                    grid-template-columns: 1fr;
                }

                .ai-send-button {
                    width: 100%;
                }

                .ai-bubble {
                    max-width: 95%;
                }
            }
            /* ===== 資料列表表格 ===== */

