@using Microsoft.AspNetCore.Http
@model List<HBaseMVC.Models.Cadaver>

@{
    ViewBag.Title = "病理教學系統";
    var edit = ViewBag.EditData as HBaseMVC.Models.Cadaver;
    var formData =
    ViewBag.PatientFormData as Dictionary<string, string>
    ?? new Dictionary<string, string>();
    int addPage = ViewBag.AddPage != null
    ? Convert.ToInt32(ViewBag.AddPage)
    : 1;
    string FormValue(string key, string editValue = "")
    {
        return formData.ContainsKey(key)
            ? formData[key]
            : editValue;
    }
    bool hasData = Model != null && Model.Count > 0;

    string role = Context.Session.GetString("Role") ?? "";

    bool isAdmin = role == "Admin";
    bool isTeacher = role == "Teacher" || role == "Admin";
    bool isStudent = role == "Student";

    string roleDisplay = role switch
    {
        "Admin" => "管理員",
        "Teacher" => "老師",
        "Student" => "學生",
        _ => "未知身分"
    };
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&family=Noto+Sans+TC:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
:root {
    --bg:        #f4f6f9;   /* 整體背景（淡灰） */
    --bg2:       #ffffff;   /* 卡片背景 */
    --bg3:       #eef1f5;   /* hover / input 背景 */

    --border:    #dcdfe6;
    --border2:   #cfd6e0;

    --accent:    #3b82f6;   /* 主色（藍） */
