@model List<HBaseMVC.Models.SurgicalTable>
@using Microsoft.AspNetCore.Http

@{
    Layout = null;

    ViewBag.Title = "手術台資料";
    var tables =
    Model
    ?? new List<HBaseMVC.Models.SurgicalTable>();
    string role =
        Context.Session.GetString("Role") ?? "";

    bool isAdmin =
        role == "Admin";

    bool isTeacher =
        role == "Teacher" || role == "Admin";

    bool isStudent =
        role == "Student";

    string roleDisplay = role switch
    {
        "Admin" => "管理員",
        "Teacher" => "老師",
        "Student" => "學生",
        _ => "未知身分"
    };

    var cadavers =
        ViewBag.Cadavers
        as List<HBaseMVC.Models.Cadaver>
        ?? new List<HBaseMVC.Models.Cadaver>();

    var schedules =
        ViewBag.ClassSchedules
        as List<HBaseMVC.Models.ClassSchedule>
        ?? new List<HBaseMVC.Models.ClassSchedule>();
}

