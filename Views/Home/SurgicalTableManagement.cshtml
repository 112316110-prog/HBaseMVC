                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897L16.862 4.487zM19.5 7.125L16.875 4.5M18 13.5v4.125A2.625 2.625 0 0115.375 20.25H5.625A2.625 2.625 0 013 17.625V7.875A2.625 2.625 0 015.625 5.25H9.75" />
                    </svg>
                    出題測驗
                </a>

                <a class="nav-item"
                   href="@Url.Action("QuizProgress", "Home")"
                   style="text-decoration:none;">
                    <svg class="nav-icon"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8m10-1v6m3-3h-6" />
                    </svg>
                    學生作答狀況
                </a>
            }

            @if (!isAdmin)
            {
                <a class="nav-item"
                   href="@Url.Action("Index", "Home", new { panel = "ai" })"
                   style="text-decoration:none;">
                    <svg class="nav-icon"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M8.625 3.75a3.375 3.375 0 016.75 0v.75h.75a3.375 3.375 0 013.375 3.375v8.25a3.375 3.375 0 01-3.375 3.375h-8.25A3.375 3.375 0 014.5 16.125v-8.25A3.375 3.375 0 017.875 4.5h.75v-.75z" />
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M9 10.5h.008v.008H9V10.5zm6 0h.008v.008H15V10.5zM9.75 15a3.75 3.75 0 004.5 0" />
                    </svg>
                    AI 助教
                </a>
            }

            @if (isStudent)
            {
                <a class="nav-item"
                   href="@Url.Action("DailyNotes", "Home")"
                   style="text-decoration:none;">
                    <svg class="nav-icon"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.5"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M6.75 3.75h10.5A2.25 2.25 0 0119.5 6v12a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 18V6a2.25 2.25 0 012.25-2.25zM8.25 8.25h7.5M8.25 12h7.5M8.25 15.75h4.5" />
                    </svg>
                    課程筆記
                </a>
            }

            <div class="sidebar-spacer"></div>

            <div class="account-card">
                <div class="account-avatar">
                    @(isAdmin ? "管" : isTeacher ? "師" : "生")
                </div>

                <div class="account-info">
                    <div class="account-name">
                        @roleDisplay
                    </div>

                    <div class="account-id">
                        @Context.Session.GetString("LoginId")
                    </div>
                </div>

                <a class="account-logout"
                   href="@Url.Action("Logout", "Home")">
                    登出
                </a>
            </div>

        </nav>

        <div class="sidebar-overlay"
             id="sidebar-overlay"
             onclick="closeSidebar()">
        </div>

        <!-- ══════════════ MAIN ══════════════ -->
        <main class="main">

            <header class="app-header">

                <button type="button"
                        class="mobile-menu-button"
                        onclick="toggleSidebar()"
                        aria-label="開啟選單">
                    ☰
                </button>

                <div class="app-header-title">
                    手術台資料
                </div>

                <div class="app-header-actions">
                    <span class="system-status">
                        <span class="status-dot"></span>
                        系統正常
                    </span>
                </div>

            </header>

            <div class="page">

                <div class="top">

                    <div class="title">
                        手術台資料
                    </div>

                </div>


                @if (TempData["Message"] != null)
                {
                    <div class="alert">
                        @TempData["Message"]
                    </div>
                }


                @* =========================
           新增手術台
           ========================= *@

                @if (isAdmin)
                {
                    <div class="card">

                        <div class="card-title">
                            新增手術台
                        </div>

                        <form method="post"
                              action="@Url.Action(
                                                                                                                    "SaveSurgicalTable",
                                                                                                                    "Home"
                                                                                                                )">

                            @Html.AntiForgeryToken()

                            <div class="form-row">

                                <div class="fg">

                                    <label>
                                        手術台編號
                                    </label>

                                    <input type="text"
                                           name="tableNumber"
                                           placeholder="例：1、7、A01"
                                           required />

                                </div>

                                <div class="fg">

                                    <label>
                                        手術台名稱
                                    </label>

                                    <input type="text"
                                           name="tableName"
                                           placeholder="未輸入則自動產生" />

                                </div>

                                <button type="submit"
                                        class="btn btn-primary">
                                    ＋ 新增手術台
                                </button>

                            </div>

                        </form>

                    </div>
                }


                @* =========================
           目前手術台
           ========================= *@

                <div class="card">

                    <div class="card-title">
                        目前手術台
                    </div>

                    @if (tables.Count == 0)
                    {
                        <div class="empty">
                            目前尚未建立手術台。
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">

                            <table>

                                <thead>

                                    <tr>

                                        <th>
                                            手術台編號
                                        </th>

                                        <th>
                                            手術台名稱
                                        </th>

                                        <th>
                                            狀態
                                        </th>

                                        @if (isAdmin)
                                        {
                                            <th>
                                                功能
                                            </th>
                                        }

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in tables)
                                    {
                                        <tr>

                                            <td>
                                                @item.TableNumber
                                            </td>

                                            <td>
                                                @item.TableName
                                            </td>

                                            <td>

                                                @if (item.IsActive)
                                                {
                                                    <span class="status-active">
                                                        啟用
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-disabled">
                                                        停用
                                                    </span>
                                                }

                                            </td>

                                            @if (isAdmin)
                                            {
                                                <td>

                                                    <form method="post"
                                                          action="@Url.Action(
                                                                                                                                                                                                                                    "ToggleSurgicalTable",
                                                                                                                                                                                                                                    "Home"
                                                                                                                                                                                                                                )"
                                                          style="display:inline;">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="rowKey"
                                                               value="@item.RowKey" />

                                                        <button type="submit"
                                                                class="btn">

                                                            @(item.IsActive
                                                                ? "停用"
                                                                : "啟用")

                                                        </button>

                                                    </form>

                                                </td>
                                            }

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>


                @* =========================
           新增上課安排
           ========================= *@

                @if (isAdmin)
                {
                    <div class="card">

                        <div class="card-title">
                            新增上課安排
                        </div>

                        <form method="post"
                              action="@Url.Action(
                                                                                                                    "SaveClassSchedule",
                                                                                                                    "Home"
                                                                                                                )">

                            @Html.AntiForgeryToken()

                            <div class="form-row">

                                <div class="fg">

                                    <label>
                                        上課日期
                                    </label>

                                    <input type="date"
                                           name="classDate"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           required />

                                </div>

                                <div class="fg">

                                    <label>
                                        手術台
                                    </label>

                                    <select name="tableId"
                                            required>

                                        <option value="">
                                            請選擇
                                        </option>

                                        @foreach (
                                            var table
                                            in tables.Where(x =>
                                                x.IsActive))
                                        {
                                            <option value="@table.RowKey">
                                                @table.TableNumber - @table.TableName
                                            </option>
                                        }

                                    </select>

                                </div>

                                <div class="fg">

                                    <label>
                                        大體老師
                                    </label>

                                    <select name="cadaverRowKey"
                                            required>

                                        <option value="">
                                            請選擇
                                        </option>

                                        @foreach (
                                            var cadaver
                                            in cadavers)
                                        {
                                            <option value="@cadaver.RowKey">
                                                @cadaver.RowKey
                                            </option>
                                        }

                                    </select>

                                </div>

                                <button type="submit"
                                        class="btn btn-primary">
                                    ＋ 新增安排
                                </button>

                            </div>

                        </form>

                    </div>
                }


                @* =========================
           目前上課安排
           ========================= *@

                <div class="card">

                    <div class="card-title">
                        目前上課安排
                    </div>

                    @if (schedules.Count == 0)
                    {
                        <div class="empty">
                            目前尚未建立上課安排。
                        </div>
                    }
                    else
                    {
                        <div class="table-wrap">

                            <table>

                                <thead>
                                    <tr>
                                        <th>上課日期</th>
                                        <th>手術台</th>
                                        <th>大體老師編號</th>

                                        @if (isAdmin)
                                        {
                                            <th>功能</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (
                                        var schedule
                                        in schedules)
                                    {
                                        var table =
                                            tables.FirstOrDefault(x =>
                                                x.RowKey ==
                                                schedule.TableId);

                                        var cadaver =
                                            cadavers.FirstOrDefault(x =>
                                                x.RowKey ==
                                                schedule.CadaverRowKey);

                                        <tr>

                                            <td>
                                                @schedule.ClassDate
                                            </td>

                                            <td>

                                                @if (table != null)
                                                {
                                                    <span>
                                                        @table.TableNumber
                                                        -
                                                        @table.TableName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        @schedule.TableId
                                                    </span>
                                                }

                                            </td>

                                            <td>

                                                @if (cadaver != null)
                                                {
                                                    <span>
                                                        @cadaver.RowKey
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        @schedule.CadaverRowKey
                                                    </span>
                                                }

                                            </td>

                                            @if (isAdmin)
                                            {
                                                <td>

                                                    <form method="post"
                                                          action="@Url.Action(
                                                                                                                                                                                                            "DeleteClassSchedule",
                                                                                                                                                                                                            "Home"
                                                                                                                                                                                                        )"
                                                          style="display:inline;">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="rowKey"
                                                               value="@schedule.RowKey" />

                                                        <button type="submit"
                                                                class="btn"
                                                                onclick="return confirm('確定要刪除此上課安排嗎？');">

                                                            刪除

                                                        </button>

                                                    </form>

                                                </td>
                                            }

                                        </tr>
                                    }

                                </tbody>
                            </table>

                        </div>
                    }

                </div>

            </div>

        </main>

    </div>

    <script>
            function toggleSidebar() {
                const sidebar =
                    document.getElementById(
                        'app-sidebar'
                    );

                const overlay =
                    document.getElementById(
                        'sidebar-overlay'
                    );

                if (!sidebar || !overlay) {
                    return;
                }

                const willOpen =
                    !sidebar.classList.contains(
                        'open'
                    );

                sidebar.classList.toggle(
                    'open',
                    willOpen
                );

                overlay.classList.toggle(
                    'open',
                    willOpen
                );

                document.body.classList.toggle(
                    'sidebar-open',
                    willOpen
                );
            }

            function closeSidebar() {
                document
                    .getElementById(
                        'app-sidebar'
                    )
                    ?.classList.remove(
                        'open'
                    );

                document
                    .getElementById(
                        'sidebar-overlay'
                    )
                    ?.classList.remove(
                        'open'
                    );

                document.body.classList.remove(
                    'sidebar-open'
                );
            }

            document.addEventListener(
                'keydown',
                function(event) {
                    if (event.key === 'Escape') {
                        closeSidebar();
                    }
                }
            );
    </script>

</body>

</html>