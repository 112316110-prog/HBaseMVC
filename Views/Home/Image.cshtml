        <!-- =========================================================
         上一筆 / 下一筆
         ========================================================= -->
        @if (hasSearch && resultCount > 0)
        {
            <div class="pager">

                @if (mediaIndex > 0)
                {
                    <a class="btn btn-primary"
                       href="@Url.Action(
                                                                                            "Image",
                                                                                            "Home",
                                                                                            new
                                                                                            {
                                                                                                row = rowKey,
                                                                                                contentType = contentType,
                                                                                                mediaType = mediaType,
                                                                                                mediaIndex = mediaIndex - 1
                                                                                            }
                                                                                        )">
                        ← 上一筆
                    </a>
                }

                @if (mediaIndex < resultCount - 1)
                {
                    <a class="btn btn-primary"
                       href="@Url.Action(
                                                                                            "Image",
                                                                                            "Home",
                                                                                            new
                                                                                            {
                                                                                                row = rowKey,
                                                                                                contentType = contentType,
                                                                                                mediaType = mediaType,
                                                                                                mediaIndex = mediaIndex + 1
                                                                                            }
                                                                                        )">
                        下一筆 →
                    </a>
                }

            </div>
