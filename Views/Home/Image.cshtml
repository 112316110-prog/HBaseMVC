@using Microsoft.AspNetCore.Http
@{
    ViewBag.Title = "病歷影像 — 病理教學系統";

    string role =
        Context.Session.GetString("Role") ?? "";

    bool isTeacher =
        role == "Teacher" ||
        role == "Admin";

    bool isStudent =
        role == "Student";

    string rowKey =
        ViewBag.RowKey as string
        ?? "";

    string contentType =
        ViewBag.ContentType as string
        ?? "";

    string mediaType =
        ViewBag.MediaType as string
        ?? "";

    bool hasSearch =
        ViewBag.HasSearch is bool search
        && search;

    int resultCount =
        ViewBag.ResultCount is int count
            ? count
            : 0;

    int mediaIndex =
        ViewBag.MediaIndex is int index
            ? index
            : 0;

    string selectedImagePath =
        ViewBag.SelectedImagePath as string
        ?? "";

    string selectedImageId =
        ViewBag.SelectedImageId as string
        ?? "";

    string selectedImageNote =
        ViewBag.SelectedImageNote as string
        ?? "";

    string selectedDrawingJson =
        ViewBag.SelectedDrawingJson as string
        ?? "[]";

    string selectedAnnotatedImagePath =
        ViewBag.SelectedAnnotatedImagePath as string
        ?? "";

    string displayImagePath =
        isStudent &&
        !string.IsNullOrWhiteSpace(
            selectedAnnotatedImagePath
        )
            ? selectedAnnotatedImagePath
            : selectedImagePath;

    bool isKaggleReferenceImage =
        (
            selectedImageNote?.Contains(
                "Kaggle 教學參考影像",
                StringComparison.OrdinalIgnoreCase
            )
            ?? false
        )
        ||
        (
            selectedImagePath?.Contains(
                "/medical-images/kaggle/",
                StringComparison.OrdinalIgnoreCase
            )
            ?? false
        );

    string selectedVideoPath =
        ViewBag.SelectedVideoPath as string
        ?? "";

    string selectedVideoNote =
        ViewBag.SelectedVideoNote as string
        ?? "";

    string selectedVideoCategory =
        ViewBag.SelectedVideoCategory as string
        ?? "未分類";

    bool selectedVideoIsAlive =
        ViewBag.SelectedVideoIsAlive is bool alive
        && alive;

    string contentLabel =
    contentType == "course"
        ? "解剖"
        : contentType == "medical"
            ? "病歷"
            : contentType == "pathology"
                ? "病理切片"
                : "";

    string mediaLabel =
        mediaType == "image"
            ? "照片"
            : mediaType == "video"
                ? "影片"
                : "";

    int drawingIndex =
        contentType == "medical"
            ? 20000
            : 10000;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&family=Noto+Sans+TC:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
            :root {
                --bg: #ffffff;
                --bg2: #ffffff;
                --bg3: #f4f4f4;
                --border: #e5e5e5;
                --border2: #d4d4d4;
                --accent: #212121;
                --accent2: #000000;
                --text: #212121;
                --text2: #676767;
                --text3: #969696;
                /* 功能性色彩保留 */
                --success: #16a34a;
                --success-bg: rgba(22, 163, 74, 0.12);
                --red: #dc2626;
                --red-bg: rgba(220, 38, 38, 0.12);
                --radius: 9px;
                --radius-lg: 16px;
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: 'Noto Sans TC', sans-serif;
                font-weight: 300;
                font-size: 14px;
                line-height: 1.7;
                min-height: 100vh;
            }

            .topbar {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 0 28px;
                height: 58px;
                border-bottom: 1px solid var(--border);
                background: var(--bg2);
            }

            .topbar-logo {
                font-family: 'Noto Serif TC',serif;
                font-size: 50px;
                font-weight: 700;
                color: var(--accent);
                letter-spacing: 2px;
            }

            .topbar a {
                color: var(--text2);
                text-decoration: none;
                font-size: 13px;
            }

                .topbar a:hover {
                    color: var(--accent);
                }

            .content {
                max-width: 1100px;
                margin: 0 auto;
                padding: 32px 28px;
            }

            .page-header {
                display: flex;
                align-items: baseline;
                gap: 14px;
                margin-bottom: 28px;
                padding-bottom: 18px;
                border-bottom: 1px solid var(--border);
            }

            .page-title {
                font-family: 'Noto Serif TC',serif;
                font-size: 22px;
                font-weight: 600;
            }

            .page-row-key {
                font-size: 13px;
                color: #676767;
                background: #f4f4f4;
                border: 1px solid #d4d4d4;
                border-radius: var(--radius);
                padding: 2px 10px;
            }

            /* ── 整體畫布區塊 ── */
            .img-block {
                display: none;
            }

                .img-block.active {
                    display: block;
                }

            /* 左右並排：畫布 + 筆畫清單 */
            .img-layout {
                display: grid;
                grid-template-columns: 1fr 300px;
                gap: 20px;
                align-items: start;
            }

            @@media (max-width: 860px) {
                .img-layout {
                    grid-template-columns: 1fr;
                }
            }

            /* ── 畫布 frame ── */
            .img-frame {
                position: relative;
                width: 100%;
            }

                .img-frame img {
                    width: 100%;
                    max-width: 100%;
                    display: block;
                    border-radius: var(--radius);
                    border: 1px solid var(--border2);
                    pointer-events: none;
                }

                .img-frame canvas {
                    position: absolute;
                    top: 0;
                    left: 0;
                    border-radius: var(--radius);
                    z-index: 10;
                    cursor: crosshair;
                }

            /* ── 工具列 ── */
            .toolbar {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                align-items: center;
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 10px;
                padding: 10px 12px;
                margin-top: 12px;
            }

            .toolbar-sep {
                width: 1px;
                height: 20px;
                background: var(--border2);
                margin: 0 2px;
            }

            .btn {
                height: 30px;
                padding: 0 13px;
                border: 1px solid #d4d4d4;
                border-radius: var(--radius);
                background: #ffffff;
                color: #212121;
                font-size: 13px;
                font-family: inherit;
                cursor: pointer;
                white-space: nowrap;
                transition: all 0.15s;
            }

                .btn:hover {
                    background: #f1f1f1;
                    border-color: #c7c7c7;
                    color: #212121;
                }

                .btn.active-tool {
                    background: #212121;
                    color: #ffffff;
                    border-color: #212121;
                }

            .btn-primary {
                background: #212121;
                border-color: #212121;
                color: #ffffff;
            }

                .btn-primary:hover {
                    background: #000000;
                    border-color: #000000;
                }

            .btn-success {
                border-color: rgba(74,156,109,0.4);
                color: #5cb88a;
            }

                .btn-success:hover {
                    background: var(--success-bg);
                }

            .btn-danger {
                border-color: rgba(220,38,38,0.4);
                color: var(--red);
            }

                .btn-danger:hover {
                    background: var(--red-bg);
                }

            /* ── 徽章 ── */
            .badge {
                display: inline-block;
                padding: 3px 10px;
                border-radius: 3px;
                font-size: 13px;
                font-weight: 500;
            }

            .badge-alive {
                background: var(--red-bg);
                color: #e05c4a;
                border: 1px solid rgba(192,57,43,0.3);
            }

            .badge-dead {
                background: var(--bg3);
                color: var(--text3);
                border: 1px solid var(--border2);
            }

            /* ── 教學說明框 ── */
            .note-box {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-left: 3px solid #969696;
                border-radius: var(--radius);
                padding: 12px 16px;
                margin-top: 12px;
            }

            .note-label {
                font-size: 11px;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: #676767;
                margin-bottom: 6px;
            }

            .note-text {
                font-size: 14px;
                color: #676767;
                line-height: 1.8;
            }

            /* ── 筆畫清單面板（右欄） ── */
            .stroke-panel {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 16px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                max-height: 700px;
            }

            .stroke-panel-head {
                background: #f7f7f8;
                padding: 10px 14px;
                font-size: 12px;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: #676767;
                border-bottom: 1px solid #e5e5e5;
                flex-shrink: 0;
            }

            .stroke-list {
                flex: 1;
                overflow-y: auto;
                padding: 8px;
            }

            .stroke-item {
                border: 1px solid #e5e5e5;
                border-radius: var(--radius);
                padding: 8px 10px;
                margin-bottom: 8px;
                background: #ffffff;
                transition: border-color .15s;
            }

                .stroke-item:hover {
                    border-color: #969696;
                }

            .stroke-item-head {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 6px;
            }

            .stroke-swatch {
                width: 16px;
                height: 16px;
                border-radius: 50%;
                border: 2px solid white;
                box-shadow: 0 1px 3px rgba(0,0,0,.25);
                flex-shrink: 0;
            }

            .stroke-tool-tag {
                font-size: 11px;
                background: var(--bg3);
                color: var(--text3);
                border-radius: 3px;
                padding: 1px 6px;
                border: 1px solid var(--border);
            }

            .stroke-num {
                font-size: 11px;
                color: var(--text3);
                margin-left: auto;
            }

            .stroke-comment-input {
                width: 100%;
                padding: 4px 8px;
                font-size: 13px;
                border: 1px solid #d4d4d4;
                border-radius: 6px;
                background: #f4f4f4;
                color: #212121;
                font-family: inherit;
                resize: none;
                min-height: 36px;
                transition: border-color .15s;
            }

                .stroke-comment-input:focus {
                    outline: none;
                    border-color: #969696;
                    background: #ffffff;
                }

                .stroke-comment-input::placeholder {
                    color: var(--text3);
                }

            .stroke-del {
                background: none;
                border: none;
                color: var(--text3);
                cursor: pointer;
                font-size: 14px;
                padding: 0 4px;
                line-height: 1;
            }

                .stroke-del:hover {
                    color: var(--red);
                }

            /* 標記數字標籤（疊在 canvas 上） */
            .stroke-label-overlay {
                position: absolute;
                z-index: 20;
                pointer-events: none;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: rgba(0,0,0,0.65);
                color: #fff;
                font-size: 11px;
                font-weight: bold;
                display: flex;
                align-items: center;
                justify-content: center;
                transform: translate(-50%,-50%);
                box-shadow: 0 1px 4px rgba(0,0,0,.4);
            }

            /* 行內彈出式註解框（canvas 正下方浮現） */
            .inline-comment-bubble {
                position: absolute;
                z-index: 50;
                background: #ffffff;
                border: 1px solid #d4d4d4;
                border-radius: 10px;
                padding: 10px 12px;
                box-shadow: 0 4px 16px rgba(0,0,0,.12);
                min-width: 220px;
                max-width: 280px;
                display: none;
            }

                .inline-comment-bubble textarea {
                    width: 100%;
                    border: 1px solid #d4d4d4;
                    border-radius: 6px;
                    padding: 5px 8px;
                    font-size: 13px;
                    font-family: inherit;
                    resize: none;
                    min-height: 52px;
                    outline: none;
                    background: #f4f4f4;
                }

                    .inline-comment-bubble textarea:focus {
                        border-color: #969696;
                        background: #ffffff;
                    }

            .inline-comment-bubble-btns {
                display: flex;
                gap: 6px;
                margin-top: 6px;
                justify-content: flex-end;
            }

            .bubble-title {
                font-size: 12px;
                color: #676767;
                font-weight: 500;
                margin-bottom: 5px;
            }
            /* empty state */
            .empty-state {
                text-align: center;
                padding: 80px 20px;
                color: var(--text3);
            }

            .empty-state-icon {
                font-size: 48px;
                margin-bottom: 14px;
                opacity: .25;
            }

            .empty-state-title {
                font-size: 16px;
                color: var(--text2);
                margin-bottom: 6px;
            }

            .reference-warning {
                margin-bottom: 14px;
                padding: 14px 16px;
                border: 1px solid #f59e0b;
                border-left: 5px solid #d97706;
                border-radius: 10px;
                background: #fffbeb;
                color: #92400e;
            }

            .reference-warning-title {
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .reference-warning-text {
                font-size: 13px;
                line-height: 1.7;
            }

            .reference-badge {
                display: inline-flex;
                align-items: center;
                min-height: 26px;
                margin: 0 0 10px 0;
                padding: 3px 10px;
                border-radius: 999px;
                border: 1px solid #f59e0b;
                background: #fff7ed;
                color: #9a3412;
                font-size: 12px;
                font-weight: 700;
            }

            ::-webkit-scrollbar {
                width: 6px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: var(--border2);
                border-radius: 3px;
            }
    </style>

    <style>
            .search-panel {
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 18px;
                margin-bottom: 24px;
            }

            .search-row {
                display: grid;
                grid-template-columns: 1fr 1fr auto;
                gap: 12px;
                align-items: end;
            }

            .search-field label {
                display: block;
                font-size: 12px;
                color: var(--text2);
                margin-bottom: 6px;
            }

            .search-field select {
                width: 100%;
                height: 38px;
                border: 1px solid var(--border2);
                border-radius: var(--radius);
                padding: 0 10px;
                background: #ffffff;
                color: var(--text);
                font-family: inherit;
                font-size: 14px;
            }

            .search-button {
                height: 38px;
                min-width: 90px;
            }

            .btn:disabled {
                opacity: .4;
                cursor: not-allowed;
            }

            .result-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 14px;
            }

            .result-count {
                font-size: 13px;
                color: var(--text3);
            }

            .pager {
                display: flex;
                gap: 8px;
                justify-content: center;
                margin-top: 22px;
            }

                .pager .btn {
                    text-decoration: none;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                }

            .media-card {
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 16px;
            }

            @@media (max-width: 760px) {
                .search-row {
                    grid-template-columns: 1fr;
                }

                .search-button {
                    width: 100%;
                }
            }
    </style>

</head>

<body>

    <header class="topbar">
        <div class="topbar-logo">
            病理教學系統
        </div>

        <span style="
            color:var(--border2);
            font-size:16px;">
            ›
        </span>

        <span style="
            font-size:20px;
            color:var(--text2);">
            病歷影像
        </span>

        <div style="flex:1;"></div>

        <a href="/Home/Index">
            ← 返回列表
        </a>
    </header>


    <div class="content">

        <div class="page-header">
            <span class="page-title">
                病歷影像
            </span>

            @if (!string.IsNullOrWhiteSpace(rowKey))
            {
                <span class="page-row-key">
                    @rowKey
                </span>
            }
        </div>


        <!-- =========================================================
         查詢條件
         ========================================================= -->
        <div class="search-panel">

            <form method="get"
                  action="@Url.Action("Image", "Home")"
                  id="mediaSearchForm">

                <input type="hidden"
                       name="row"
                       value="@rowKey" />

                <div class="search-row">

                    <div class="search-field">
                        <label for="contentType">
                            資料類型
                        </label>

                        <select id="contentType"
                                name="contentType">

                            <option value="">
                                請選擇
                            </option>

                            <option value="course"
                                    selected="@(contentType == "course" ? "selected" : null)">
                                解剖
                            </option>

                            <option value="medical"
                                    selected="@(contentType == "medical" ? "selected" : null)">
                                病歷
                            </option>

                            <option value="pathology"
                                    selected="@(contentType == "pathology" ? "selected" : null)">
                                病理切片
                            </option>

                        </select>
                    </div>


                    <div class="search-field">
                        <label for="mediaType">
                            媒體類型
                        </label>

                        <select id="mediaType"
                                name="mediaType">

                            <option value="">
                                請選擇
                            </option>

                            <option value="image"
                                    selected="@(mediaType == "image" ? "selected" : null)">
                                照片
                            </option>

                            <option value="video"
                                    selected="@(mediaType == "video" ? "selected" : null)">
                                影片
                            </option>

                        </select>
                    </div>


                    <button type="submit"
                            id="searchButton"
                            class="btn btn-primary search-button"
                            disabled>
                        查詢
                    </button>

                </div>
            </form>
        </div>


        <!-- =========================================================
         初次進入：不顯示任何照片 / 影片
         ========================================================= -->
        @if (!hasSearch)
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    🔎
                </div>

                <div class="empty-state-title">
                    請選擇查詢條件
                </div>

                <div style="
                    font-size:13px;
                    margin-top:6px;">
                    請先選擇「解剖／病歷」與「照片／影片」後再按查詢。
                </div>

            </div>
        }

        <!-- =========================================================
         查無資料
         ========================================================= -->
        @if (hasSearch && resultCount == 0)
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    @(mediaType == "video" ? "🎬" : "🖼")
                </div>

                <div class="empty-state-title">
                    查無符合條件的資料
                </div>

                <div style="
                    font-size:13px;
                    margin-top:6px;">
                    目前沒有「@contentLabel / @mediaLabel」資料。
                </div>

            </div>
        }

        <!-- =========================================================
         照片：一次只顯示一張
         ========================================================= -->
        @if (hasSearch && resultCount > 0 && mediaType == "image")
        {
            <div class="result-head">

                <div>
                    <div class="page-title"
                         style="font-size:18px;">
                        @contentLabel 照片
                    </div>
                </div>

                <div class="result-count">
                    @(mediaIndex + 1) / @resultCount
                </div>

            </div>


            @if (isKaggleReferenceImage)
            {
                <div class="reference-warning">
                    <div class="reference-warning-title">
                        教學參考影像 / Kaggle Chest X-Ray
                    </div>

                    <div class="reference-warning-text">
                        此影像僅供教學參考，非此病人的真實醫療影像，
                        不可作為此病人的診斷、病歷事實或臨床判讀依據。
                    </div>
                </div>
            }

            <div class="media-card">

                <div class="img-layout"
                     style="@(isTeacher ? "" : "grid-template-columns:1fr;")">

                    <!-- 左側：圖片與畫圖工具 -->
                    <div>

                        <div style="position:relative;"
                             id="canvaswrap_@drawingIndex">

                            @if (isKaggleReferenceImage)
                            {
                                <div class="reference-badge">
                                    非此病人真實影像
                                </div>
                            }

                            <div class="img-frame"
                                 id="frame_@drawingIndex">

                                <img id="img_@drawingIndex"
                                     src="@displayImagePath"
                                     alt="@contentLabel 照片 @(mediaIndex + 1)" />

                                @if (isTeacher)
                                {
                                    <canvas id="canvas_@drawingIndex">
                                    </canvas>
                                }

                            </div>


                            @if (isTeacher)
                            {
                                <div class="inline-comment-bubble"
                                     id="bubble_@drawingIndex">

                                    <div class="bubble-title">
                                        💬 為此標記加上說明
                                    </div>

                                    <textarea id="bubble_text_@drawingIndex"
                                              placeholder="輸入說明文字（可留空）"
                                              rows="2"></textarea>

                                    <div class="inline-comment-bubble-btns">

                                        <button type="button"
                                                class="btn"
                                                style="
                                            height:26px;
                                            font-size:12px;"
                                                onclick="bubbleSkip(@drawingIndex)">
                                            略過
                                        </button>

                                        <button type="button"
                                                class="btn btn-primary"
                                                style="
                                            height:26px;
                                            font-size:12px;"
                                                onclick="bubbleConfirm(@drawingIndex)">
                                            確認
                                        </button>

                                    </div>
                                </div>
                            }

                        </div>


                        @if (isTeacher)
                        {
                            <div class="toolbar"
                                 id="toolbar_@drawingIndex">

                                <button type="button"
                                        class="btn active-tool"
                                        id="tb_pen_@drawingIndex"
                                        onclick="setTool(@drawingIndex,'pen')">
                                    🖊 畫筆
                                </button>

                                <button type="button"
                                        class="btn"
                                        id="tb_arrow_@drawingIndex"
                                        onclick="setTool(@drawingIndex,'arrow')">
                                    ➤ 箭頭
                                </button>

                                <button type="button"
                                        class="btn"
                                        id="tb_rect_@drawingIndex"
                                        onclick="setTool(@drawingIndex,'rect')">
                                    ▭ 矩形
                                </button>

                                <button type="button"
                                        class="btn"
                                        id="tb_circle_@drawingIndex"
                                        onclick="setTool(@drawingIndex,'circle')">
