                                border-radius:4px;
                                padding:1px;
                                cursor:pointer;" />

                                <select id="width_@drawingIndex"
                                        style="
                                    height:30px;
                                    padding:0 6px;
                                    border:1px solid var(--border2);
                                    border-radius:4px;
                                    font-size:13px;
                                    background:var(--bg3);
                                    color:var(--text);
                                    cursor:pointer;">

                                    <option value="2">
                                        細
                                    </option>

                                    <option value="4"
                                            selected>
                                        中
                                    </option>

                                    <option value="8">
                                        粗
                                    </option>

                                    <option value="14">
                                        超粗
                                    </option>

                                </select>

                                <div class="toolbar-sep"></div>

                                <button type="button"
                                        class="btn"
                                        onclick="undoStroke(@drawingIndex)">
                                    ↩ 復原
                                </button>

                                <button type="button"
                                        class="btn btn-danger"
                                        onclick="clearAllStrokes(@drawingIndex)">
                                    🗑 清除全部
                                </button>

                                <button type="button"
                                        class="btn btn-success"
                                        id="savebtn_@drawingIndex"
                                        onclick="saveDrawing(
                                    '@rowKey',
                                    '@selectedImageId',
                                    '@contentType',
                                    @drawingIndex
                                    )">
                                    💾 儲存標記
                                </button>

                                <button type="button"
                                        class="btn btn-danger"
                                        onclick="deleteImage(
                                    '@rowKey',
                                    '@selectedImagePath',
                                    '@contentType'
                                    )">
                                    🗑 刪除照片
                                </button>

                            </div>
                        }


                        @if (!string.IsNullOrWhiteSpace(
                                selectedImageNote))
                        {
                            <div class="note-box">

                                <div class="note-label">
                                    @(isKaggleReferenceImage
                                        ? "教學參考影像說明"
                                        : $"{contentLabel} 照片說明")
                                </div>

                                <div class="note-text">
                                    @selectedImageNote
                                </div>

                            </div>
                        }

                    </div>


                    <!-- 右側：標記清單 -->
                    @if (isTeacher)
                    {
                        <div class="stroke-panel"
                             id="panel_@drawingIndex">

                            <div class="stroke-panel-head">
                                🏷 標記與說明
                            </div>

                            <div class="stroke-list"
                                 id="strokelist_@drawingIndex">

                                <div style="
                                    color:var(--text3);
                                    font-size:13px;
                                    text-align:center;
                                    padding:20px 0;">
                                    尚無標記
                                </div>

                            </div>
                        </div>
                    }

                </div>
            </div>


            @if (isTeacher)
            {
                <script>
                                    document.addEventListener(
                                        'DOMContentLoaded',
                                        function() {
                                            initializeDrawingEditor(
                                                                                        @drawingIndex,
                                                                                        @Html.Raw(
                                                                                                                        selectedDrawingJson == "[]"
        ? "[]"
        : selectedDrawingJson
        ),
                                                true
                                            );
                                        }
                                    );
                </script>
            }
        }

        <!-- =========================================================
         影片：一次只顯示一部
         ========================================================= -->
        @if (hasSearch && resultCount > 0 && mediaType == "video")
        {
            <div class="result-head">

                <div>
                    <div class="page-title"
                         style="font-size:18px;">
                        @contentLabel 影片
                    </div>
                </div>

                <div class="result-count">
                    @(mediaIndex + 1) / @resultCount
                </div>

            </div>


            <div class="media-card">

                <video controls
                       style="
                    width:100%;
                    max-width:900px;
                    display:block;
                    margin:0 auto;
                    border-radius:6px;
                    border:1px solid var(--border2);">

                    <source src="@selectedVideoPath"
                            type="video/mp4" />

                    您的瀏覽器不支援影片播放。
                </video>


                <div style="
                    margin-top:12px;
                    display:flex;
                    gap:8px;
                    flex-wrap:wrap;">

                    @if (!string.IsNullOrWhiteSpace(
                            selectedVideoCategory))
                    {
                        <span class="badge badge-dead">
                            @selectedVideoCategory
                        </span>
                    }

                    <span class="@(selectedVideoIsAlive
                                                                                          ? "badge badge-alive"
                                                                                          : "badge badge-dead")">

                        @(selectedVideoIsAlive
                            ? "生前影像"
                            : "非生前影像")

                    </span>

                </div>


                @if (!string.IsNullOrWhiteSpace(
                        selectedVideoNote))
                {
                    <div class="note-box">

                        <div class="note-label">
                            @contentLabel 影片說明
                        </div>

                        <div class="note-text">
                            @selectedVideoNote
                        </div>

                    </div>
                }


                @if (isTeacher)
                {
                    <div style="
                        margin-top:14px;
                        display:flex;
                        gap:8px;">

                        <button type="button"
                                class="btn btn-danger"
                                onclick="deleteVideo(
                            '@rowKey',
                            '@selectedVideoPath'
                            )">
                            🗑 刪除影片
                        </button>

                    </div>
