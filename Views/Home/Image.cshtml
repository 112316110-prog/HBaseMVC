    </div>


    <script>
            document.addEventListener(
                'DOMContentLoaded',
                function() {

                    const contentType =
                        document.getElementById(
                            'contentType'
                        );

                    const mediaType =
                        document.getElementById(
                            'mediaType'
                        );

                    const searchButton =
                        document.getElementById(
                            'searchButton'
                        );

                    function updateSearchButton() {

                        if (
                            !contentType ||
                            !mediaType ||
                            !searchButton
                        ) {
                            return;
                        }

                        searchButton.disabled =
                            contentType.value === '' ||
                            mediaType.value === '';
                    }

                    contentType.addEventListener(
                        'change',
                        updateSearchButton
                    );

                    mediaType.addEventListener(
                        'change',
                        updateSearchButton
                    );

                    updateSearchButton();
                }
            );
    </script>

    <script>
            /* ═══════════════════════════════════════════
               全域畫圖 / 儲存 / 刪除功能
            ═══════════════════════════════════════════ */
            function initializeDrawingEditor(
                IDX,
                initJson,
                CAN_EDIT
            ) {
                var strokes = [];

                var curTool =
                    'pen';

                var isDrawing =
                    false;

                var startX = 0;
                var startY = 0;

                var snapData =
                    null;

                var pendingStrokeIdx =
                    -1;


                var imgEl =
                    document.getElementById(
                        'img_' + IDX
                    );

                var canvas =
                    document.getElementById(
                        'canvas_' + IDX
                    );

                if (!imgEl || !canvas) {
                    return;
                }

                var ctx =
                    canvas.getContext('2d');

                var bubble =
                    document.getElementById(
                        'bubble_' + IDX
                    );

                var bubbleTx =
                    document.getElementById(
                        'bubble_text_' + IDX
                    );


                if (!CAN_EDIT) {
                    canvas.style.pointerEvents =
                        'none';

                    canvas.style.cursor =
                        'default';
                }


                try {
                    strokes =
                        Array.isArray(initJson)
                            ? initJson
                            : JSON.parse(
                                initJson || '[]'
                            );
                }
                catch (e) {
                    strokes =
                        [];
                }


                function resize() {
                    var rect =
                        imgEl.getBoundingClientRect();

                    if (rect.width === 0) {
                        return;
                    }

                    canvas.width =
                        rect.width;

                    canvas.height =
                        rect.height;

                    canvas.style.width =
                        rect.width + 'px';

                    canvas.style.height =
                        rect.height + 'px';

                    redraw();
                    renderOverlays();
                }


                function tryResize() {
                    var rect =
                        imgEl.getBoundingClientRect();

                    if (rect.width === 0) {
                        setTimeout(
                            tryResize,
                            80
                        );

                        return;
                    }

                    resize();
                }


                function paintStroke(c, s) {
                    c.save();

                    c.strokeStyle =
                        s.color || '#e8b84b';

                    c.fillStyle =
                        s.color || '#e8b84b';

                    c.lineWidth =
                        +(s.width || 4);

                    c.lineCap =
                        'round';

                    c.lineJoin =
                        'round';

                    var pts =
                        s.points || [];


                    if (s.tool === 'pen') {
                        if (pts.length < 2) {
                            c.restore();
                            return;
                        }

                        c.beginPath();

                        pts.forEach(
                            function(p, i) {
                                if (i === 0) {
                                    c.moveTo(
                                        p[0],
                                        p[1]
                                    );
                                }
                                else {
                                    c.lineTo(
                                        p[0],
                                        p[1]
                                    );
                                }
                            }
                        );

                        c.stroke();
                    }


                    else if (
                        s.tool === 'eraser'
                    ) {
                        c.globalCompositeOperation =
                            'destination-out';

                        c.lineWidth =
                            +(s.width || 4) * 4;

                        c.beginPath();

                        pts.forEach(
                            function(p, i) {
                                if (i === 0) {
                                    c.moveTo(
                                        p[0],
                                        p[1]
                                    );
                                }
                                else {
                                    c.lineTo(
                                        p[0],
                                        p[1]
                                    );
                                }
                            }
                        );

                        c.stroke();
                    }


                    else if (
                        s.tool === 'line' &&
                        pts.length >= 2
                    ) {
                        c.beginPath();

                        c.moveTo(
                            pts[0][0],
                            pts[0][1]
                        );

                        c.lineTo(
                            pts[pts.length - 1][0],
                            pts[pts.length - 1][1]
                        );

                        c.stroke();
                    }


                    else if (
                        s.tool === 'arrow' &&
                        pts.length >= 2
                    ) {
                        var x1 =
                            pts[0][0];

                        var y1 =
                            pts[0][1];

                        var x2 =
                            pts[pts.length - 1][0];

                        var y2 =
                            pts[pts.length - 1][1];

                        c.beginPath();

                        c.moveTo(
                            x1,
                            y1
                        );

                        c.lineTo(
                            x2,
                            y2
                        );

                        c.stroke();

                        var angle =
                            Math.atan2(
                                y2 - y1,
                                x2 - x1
                            );

                        var headSize =
                            Math.max(
                                14,
                                +(s.width || 4) * 3.5
                            );

                        c.beginPath();

                        c.moveTo(
                            x2,
                            y2
                        );

                        c.lineTo(
                            x2 -
                            headSize *
                            Math.cos(
                                angle - 0.42
                            ),

                            y2 -
                            headSize *
                            Math.sin(
                                angle - 0.42
                            )
                        );

                        c.lineTo(
                            x2 -
                            headSize *
                            Math.cos(
                                angle + 0.42
                            ),

                            y2 -
                            headSize *
                            Math.sin(
                                angle + 0.42
                            )
                        );

                        c.closePath();
                        c.fill();
                    }


                    else if (
                        s.tool === 'rect' &&
                        pts.length >= 2
                    ) {
                        var rx =
                            pts[0][0];

                        var ry =
                            pts[0][1];

                        var rw =
                            pts[pts.length - 1][0] -
                            rx;

                        var rh =
                            pts[pts.length - 1][1] -
                            ry;

                        c.strokeRect(
                            rx,
                            ry,
                            rw,
                            rh
                        );
                    }


                    else if (
                        s.tool === 'circle' &&
                        pts.length >= 2
                    ) {
                        var cx =
                            pts[0][0];

                        var cy =
                            pts[0][1];

                        var radiusX =
                            Math.abs(
                                pts[pts.length - 1][0] -
                                cx
                            );

                        var radiusY =
                            Math.abs(
                                pts[pts.length - 1][1] -
                                cy
                            );

                        c.beginPath();

                        c.ellipse(
                            cx,
                            cy,
                            Math.max(radiusX, 1),
                            Math.max(radiusY, 1),
                            0,
                            0,
                            Math.PI * 2
                        );

                        c.stroke();
                    }


                    else if (
                        s.tool === 'text' &&
                        pts.length >= 1
                    ) {
                        var fontSize =
                            Math.max(
                                14,
                                +(s.width || 4) * 3 + 8
                            );

                        c.font =
                            'bold ' +
                            fontSize +
                            'px "Noto Sans TC", sans-serif';

                        c.fillText(
                            s.text || '',
                            pts[0][0],
                            pts[0][1]
                        );
                    }


                    c.restore();
                }


                function redraw() {
                    ctx.clearRect(
                        0,
                        0,
                        canvas.width,
                        canvas.height
                    );

                    strokes.forEach(
                        function(s) {
                            paintStroke(
                                ctx,
                                s
                            );
                        }
                    );
                }


                function anchorPoint(s) {
                    var pts =
                        s.points || [];

                    if (!pts.length) {
                        return null;
                    }

                    if (
                        s.tool === 'text' ||
                        s.tool === 'pen' ||
                        s.tool === 'eraser'
                    ) {
                        return pts[0];
                    }

                    return pts[
                        pts.length - 1
                    ];
                }


                function renderOverlays() {
                    var frame =
                        document.getElementById(
                            'frame_' + IDX
                        );

                    if (!frame) {
                        return;
                    }

                    frame
                        .querySelectorAll(
                            '.stroke-label-overlay'
                        )
                        .forEach(
                            function(el) {
                                el.remove();
                            }
                        );


                    var visible =
                        strokes.filter(
                            function(s) {
                                return s.tool !==
                                    'eraser';
                            }
                        );


                    visible.forEach(
                        function(s, vi) {
                            var pt =
                                anchorPoint(s);

                            if (!pt) {
                                return;
                            }

                            var label =
                                document.createElement(
                                    'div'
                                );

                            label.className =
                                'stroke-label-overlay';

                            label.textContent =
                                vi + 1;

                            label.style.left =
                                pt[0] + 'px';

                            label.style.top =
                                pt[1] + 'px';

                            label.style.background =
                                s.color || '#333';

                            frame.appendChild(
                                label
                            );
                        }
                    );
                }


                function getPos(e) {
                    var rect =
                        canvas.getBoundingClientRect();

                    var clientX =
                        e.clientX;

                    var clientY =
                        e.clientY;

                    return [
                        (clientX - rect.left) *
                        (canvas.width / rect.width),

                        (clientY - rect.top) *
                        (canvas.height / rect.height)
                    ];
                }


                function makeStroke(
                    tool,
                    points,
                    text
                ) {
                    var colorInput =
                        document.getElementById(
                            'color_' + IDX
                        );

                    var widthInput =
                        document.getElementById(
                            'width_' + IDX
                        );

                    return {
                        tool: tool,

                        color:
                            colorInput
                                ? colorInput.value
                                : '#e8b84b',

                        width:
                            widthInput
                                ? parseInt(
                                    widthInput.value
                                )
                                : 4,

                        points: points,

                        text:
                            text || '',

                        comment:
                            ''
                    };
                }


                function showBubble(x, y) {
                    if (!bubble ||
                        !bubbleTx) {
                        pendingStrokeIdx =
                            -1;

                        renderList();

                        return;
                    }

                    bubble.style.left =
                        Math.max(
                            4,
                            x + 12
                        ) + 'px';

                    bubble.style.top =
                        (y + 8) + 'px';

                    bubble.style.display =
                        'block';

                    bubbleTx.value =
                        '';

                    bubbleTx.focus();
                }


                function hideBubble() {
                    if (bubble) {
                        bubble.style.display =
                            'none';
                    }
                }


                function escapeHtml(value) {
                    return String(
                        value || ''
                    )
                        .replace(
                            /&/g,
                            '&amp;'
                        )
                        .replace(
                            /</g,
                            '&lt;'
                        )
                        .replace(
                            />/g,
                            '&gt;'
                        );
                }


                function renderList() {
                    var element =
                        document.getElementById(
                            'strokelist_' + IDX
                        );

                    if (!element) {
                        return;
                    }

                    var visible =
                        strokes.filter(
                            function(s) {
                                return s.tool !==
                                    'eraser';
                            }
                        );

                    if (!visible.length) {
                        element.innerHTML =
                            '<div style="' +
                            'color:var(--text3);' +
                            'font-size:13px;' +
                            'text-align:center;' +
                            'padding:20px 0;">' +
                            '尚無標記' +
                            '</div>';

                        return;
                    }

                    element.innerHTML =
                        '';

                    visible.forEach(
                        function(s, vi) {

                            var names = {
                                pen: '畫筆',
                                arrow: '箭頭',
                                rect: '矩形',
                                circle: '圓形',
                                line: '直線',
                                text: '文字'
                            };

                            var div =
                                document.createElement(
                                    'div'
                                );

                            div.className =
                                'stroke-item';

                            div.innerHTML =
                                '<div class="stroke-item-head">' +

                                '<span class="stroke-swatch" ' +
                                'style="background:' +
                                (s.color || '#333') +
                                '"></span>' +

                                '<span class="stroke-tool-tag">' +
                                (names[s.tool] || s.tool) +
                                '</span>' +

                                '<span class="stroke-num">#' +
                                (vi + 1) +
                                '</span>' +

                                '<button type="button" ' +
                                'class="stroke-del" ' +
                                'onclick="delStroke_' +
                                IDX +
                                '(' +
                                vi +
                                ')">✕</button>' +

                                '</div>' +

                                '<textarea ' +
                                'class="stroke-comment-input" ' +
                                'placeholder="尚無說明，點此輸入…" ' +
                                'oninput="updComment_' +
                                IDX +
                                '(' +
                                vi +
                                ',this.value)">' +

                                escapeHtml(
                                    s.comment || ''
                                ) +

                                '</textarea>';

                            element.appendChild(
                                div
                            );
                        }
                    );
                }


                canvas.addEventListener(
                    'mousedown',
                    function(e) {

                        if (!CAN_EDIT) {
                            return;
                        }

                        e.preventDefault();

                        if (
                            pendingStrokeIdx >= 0
                        ) {
                            return;
                        }

                        var pos =
                            getPos(e);

                        startX =
                            pos[0];

                        startY =
                            pos[1];

                        isDrawing =
                            true;


                        if (curTool === 'text') {
                            isDrawing =
                                false;

                            var text =
                                prompt(
                                    '請輸入文字標記：'
                                );

                            if (!text) {
                                return;
                            }

                            strokes.push(
                                makeStroke(
                                    'text',
                                    [[startX, startY]],
                                    text
                                )
                            );

                            redraw();
                            renderOverlays();

                            pendingStrokeIdx =
                                strokes.length - 1;

                            showBubble(
                                startX,
                                startY
                            );

                            return;
                        }


                        if (
                            curTool === 'rect' ||
                            curTool === 'circle' ||
                            curTool === 'arrow' ||
                            curTool === 'line'
                        ) {
                            snapData =
                                ctx.getImageData(
                                    0,
                                    0,
                                    canvas.width,
                                    canvas.height
                                );
                        }
                    }
                );


                canvas.addEventListener(
                    'mousemove',
                    function(e) {

                        if (!CAN_EDIT ||
                            !isDrawing) {
                            return;
                        }

                        e.preventDefault();

                        var pos =
                            getPos(e);


                        if (
                            curTool === 'pen' ||
                            curTool === 'eraser'
                        ) {
                            if (
                                !strokes.length ||
                                !strokes[
                                    strokes.length - 1
                                ]._live
                            ) {
                                strokes.push(
                                    makeStroke(
                                        curTool,
                                        [[startX, startY]]
                                    )
                                );

                                strokes[
                                    strokes.length - 1
                                ]._live =
                                    true;
                            }

                            strokes[
                                strokes.length - 1
                            ].points.push(
                                [pos[0], pos[1]]
                            );

                            redraw();
                        }
                        else {
                            if (snapData) {
                                ctx.putImageData(
                                    snapData,
                                    0,
                                    0
                                );
                            }

                            paintStroke(
                                ctx,
                                makeStroke(
                                    curTool,
                                    [
                                        [startX, startY],
                                        [pos[0], pos[1]]
                                    ]
                                )
                            );
                        }
                    }
                );


                canvas.addEventListener(
                    'mouseup',
                    function(e) {

                        if (!CAN_EDIT ||
                            !isDrawing) {
                            isDrawing =
                                false;

                            return;
                        }

                        isDrawing =
                            false;

                        var pos =
                            getPos(e);


                        if (
                            curTool === 'pen' ||
                            curTool === 'eraser'
                        ) {
                            if (strokes.length) {
                                delete strokes[
                                    strokes.length - 1
                                ]._live;
                            }

                            redraw();
                            renderOverlays();

                            if (
                                curTool ===
                                'eraser'
                            ) {
                                renderList();
                                return;
                            }

                            pendingStrokeIdx =
                                strokes.length - 1;

                            var anchor =
                                strokes[
                                    pendingStrokeIdx
                                ].points[0];

                            showBubble(
                                anchor[0],
                                anchor[1]
                            );
                        }
                        else {
                            snapData =
                                null;

                            strokes.push(
                                makeStroke(
                                    curTool,
                                    [
                                        [startX, startY],
                                        [pos[0], pos[1]]
                                    ]
                                )
                            );

                            redraw();
                            renderOverlays();

                            pendingStrokeIdx =
                                strokes.length - 1;

                            showBubble(
                                pos[0],
                                pos[1]
                            );
                        }
                    }
                );


                window[
                    'setTool_' + IDX
                ] =
                    function(tool) {

                        curTool =
                            tool;

                        [
                            'pen',
                            'arrow',
                            'rect',
                            'circle',
                            'line',
                            'text',
                            'eraser'
                        ].forEach(
                            function(name) {

                                var button =
                                    document.getElementById(
                                        'tb_' +
                                        name +
                                        '_' +
                                        IDX
                                    );

                                if (button) {
                                    button.classList.toggle(
                                        'active-tool',
                                        name === tool
                                    );
                                }
                            }
                        );
                    };


                window[
                    'undoStroke_' + IDX
                ] =
                    function() {

                        hideBubble();

                        pendingStrokeIdx =
                            -1;

                        if (strokes.length) {
                            strokes.pop();

                            redraw();
                            renderOverlays();
                            renderList();
                        }
                    };


                window[
                    'clearAllStrokes_' + IDX
                ] =
                    function() {

                        if (!confirm(
                            '確定清除所有標記？'
                        )) {
                            return;
                        }

                        strokes =
                            [];

                        redraw();
                        renderOverlays();
                        renderList();
                    };


                window[
                    'bubbleConfirm_' + IDX
                ] =
                    function() {

                        if (
                            pendingStrokeIdx >= 0 &&
                            pendingStrokeIdx <
                            strokes.length
                        ) {
                            strokes[
                                pendingStrokeIdx
                            ].comment =
                                bubbleTx
                                    ? bubbleTx.value.trim()
                                    : '';
                        }

                        pendingStrokeIdx =
                            -1;

                        hideBubble();

                        renderList();
                        renderOverlays();
                    };


                window[
                    'bubbleSkip_' + IDX
                ] =
                    function() {

                        pendingStrokeIdx =
                            -1;

                        hideBubble();

                        renderList();
                        renderOverlays();
                    };


                window[
                    'delStroke_' + IDX
                ] =
                    function(visibleIndex) {

                        var visible =
                            strokes.filter(
                                function(s) {
                                    return s.tool !==
                                        'eraser';
                                }
                            );

                        var target =
                            visible[
                            visibleIndex
                            ];

                        strokes =
                            strokes.filter(
                                function(s) {
                                    return s !==
                                        target;
                                }
                            );

                        redraw();
                        renderOverlays();
                        renderList();
                    };


                window[
                    'updComment_' + IDX
                ] =
                    function(
                        visibleIndex,
                        value
                    ) {
                        var visible =
                            strokes.filter(
                                function(s) {
                                    return s.tool !==
                                        'eraser';
                                }
                            );

                        if (
                            visible[
                            visibleIndex
                            ]
                        ) {
                            visible[
                                visibleIndex
                            ].comment =
                                value;
                        }
                    };


                window[
                    'getStrokes_' + IDX
                ] =
                    function() {
                        return strokes;
                    };


                window[
                    'getCanvas_' + IDX
                ] =
                    function() {
                        return canvas;
                    };


                window[
                    'getImg_' + IDX
                ] =
                    function() {
                        return imgEl;
                    };


                if (
                    imgEl.complete &&
                    imgEl.naturalWidth > 0
                ) {
                    tryResize();
                    redraw();
                    renderList();
                }
                else {
                    imgEl.addEventListener(
                        'load',
                        function() {
                            tryResize();
                            redraw();
                            renderList();
                        }
                    );
                }


                window.addEventListener(
                    'resize',
                    resize
                );
            }
            function setTool(i, t) { if (window['setTool_' + i]) window['setTool_' + i](t); }
            function undoStroke(i) { if (window['undoStroke_' + i]) window['undoStroke_' + i](); }
            function clearAllStrokes(i) { if (window['clearAllStrokes_' + i]) window['clearAllStrokes_' + i](); }
            function bubbleConfirm(i) { if (window['bubbleConfirm_' + i]) window['bubbleConfirm_' + i](); }
            function bubbleSkip(i) { if (window['bubbleSkip_' + i]) window['bubbleSkip_' + i](); }

            /* ── 儲存：筆畫 JSON + 合成圖 ── */
            async function saveDrawing(row, imageId, imageType, i) {
                var btn = document.getElementById('savebtn_' + i);
                var strokes = window['getStrokes_' + i] ? window['getStrokes_' + i]() : [];
                var canvas = window['getCanvas_' + i] ? window['getCanvas_' + i]() : null;
                var imgEl = window['getImg_' + i] ? window['getImg_' + i]() : null;

                // 合成圖（底圖 + 筆畫）
                var base64 = '';
                if (canvas && imgEl) {
                    var tmp = document.createElement('canvas');
                    tmp.width = canvas.width;
                    tmp.height = canvas.height;
                    var tc = tmp.getContext('2d');
                    tc.drawImage(imgEl, 0, 0, tmp.width, tmp.height);
                    tc.drawImage(canvas, 0, 0);
                    base64 = tmp.toDataURL('image/png');
                }

                // 去除 _live flag
                var clean = strokes.map(function(s) { var c = Object.assign({}, s); delete c._live; return c; });

                if (btn) { btn.textContent = '儲存中…'; btn.disabled = true; }
                try {
                    var resp = await fetch('/Home/SaveDrawing', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body:
                            'row=' +
                            encodeURIComponent(row) +

                            '&imageId=' +
                            encodeURIComponent(imageId) +

                            '&imageType=' +
                            encodeURIComponent(imageType) +

                            '&drawingJson=' +
                            encodeURIComponent(
                                JSON.stringify(clean)
                            ) +

                            '&annotatedImageBase64=' +
                            encodeURIComponent(base64)
                    });
                    if (resp.ok) {
                        if (btn) { btn.textContent = '✔ 已儲存'; btn.style.color = '#5cb88a'; btn.style.borderColor = 'var(--success)'; }
                        setTimeout(function() {
                            if (btn) { btn.textContent = '💾 儲存標記'; btn.style.color = ''; btn.style.borderColor = ''; btn.disabled = false; }
                        }, 2200);
                    } else {
                        if (btn) { btn.textContent = '❌ 失敗'; btn.disabled = false; }
                    }
                } catch (e) {
                    if (btn) { btn.textContent = '❌ 網路錯誤'; btn.disabled = false; }
                }
            }

            /* ── 圖片切換 ── */
            var currentIndex = 0;
            function showImage(idx) {
                var blocks = document.querySelectorAll('.img-block');
                if (!blocks.length) return;
                if (idx < 0) idx = 0;
                if (idx >= blocks.length) idx = blocks.length - 1;
                currentIndex = idx;
                blocks.forEach(function(el, i) { el.classList.toggle('active', i === idx); });
            }
            function nextImage() { showImage(currentIndex + 1); }
            function prevImage() { showImage(currentIndex - 1); }
            document.addEventListener('DOMContentLoaded', function() { showImage(0); });

            /* ── 刪除圖片 / 影片 ── */
            async function deleteImage(
                rowKey,
                imgPath,
                imageType
            ) {
                if (!confirm(
                    '確定要刪除這張影像嗎？'
                )) {
                    return;
                }

                try {
                    const res =
                        await fetch(
                            '/Home/DeleteImage',
                            {
                                method: 'POST',

                                headers: {
                                    'Content-Type':
                                        'application/json'
                                },

                                body: JSON.stringify({
                                    rowKey: rowKey,
                                    imgPath: imgPath,
                                    imageType: imageType
                                })
                            }
                        );

                    if (res.ok) {
                        alert(
                            '圖片刪除成功'
                        );

                        location.reload();

                        return;
                    }

                    const message =
                        await res.text();

                    alert(
                        '圖片刪除失敗：\n' +
                        message
                    );
                }
                catch (error) {
                    alert(
                        '圖片刪除失敗：網路或伺服器錯誤'
                    );
                }
            }
            function deleteVideo(rowKey, videoPath) {
                if (!confirm('確定刪除這部影片？')) return;
                fetch('/Home/DeleteVideo', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rowKey: rowKey, videoPath: videoPath })
                }).then(async function(res) {
                    var msg = await res.text();
                    if (res.ok) { alert('影片刪除成功'); location.reload(); }
                    else alert('影片刪除失敗：\n' + msg);
                });
            }
    </script>
</body>
</html>