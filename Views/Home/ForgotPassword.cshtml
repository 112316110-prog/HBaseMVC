@{
    Layout = null;
    ViewBag.Title = "忘記密碼 — 病理教學系統";
}

<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title</title>

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: #ffffff;
            font-family: "Microsoft JhengHei", sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #212121;
        }

        .box {
            width: 420px;
            max-width: calc(100% - 32px);
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 16px;
            padding: 32px;
            box-sizing: border-box;
        }

        .title {
            margin-bottom: 6px;
            text-align: center;
            font-size: 30px;
            font-weight: 700;
        }

        .sub {
            margin-bottom: 24px;
            text-align: center;
            color: #676767;
            font-size: 14px;
        }

        .role-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 18px;
        }

        .role-card {
            border: 1px solid #d4d4d4;
            border-radius: 9px;
            padding: 14px;
            text-align: center;
            cursor: pointer;
            background: #ffffff;
            color: #676767;
        }

        .role-card input {
            display: none;
        }

        .role-card:has(input:checked) {
            border-color: #212121;
            background: #f4f4f4;
            color: #212121;
            font-weight: 700;
        }

        .fg {
            margin-bottom: 14px;
        }

        .fg label {
            display: block;
            margin-bottom: 6px;
            font-size: 14px;
            color: #676767;
        }

        .fg input {
            width: 100%;
            height: 38px;
            padding: 0 10px;
            border: 1px solid #d4d4d4;
            border-radius: 9px;
            background: #f4f4f4;
            color: #212121;
            font-size: 15px;
            box-sizing: border-box;
        }

        .fg input:focus {
            outline: none;
            border-color: #969696;
        }

        .btn {
            width: 100%;
            height: 42px;
            margin-top: 8px;
            border: none;
            border-radius: 9px;
            background: #212121;
            color: #ffffff;
            font-size: 16px;
            cursor: pointer;
        }

        .btn:hover {
            background: #000000;
        }

        .alert {
            margin-bottom: 16px;
            padding: 10px;
            border: 1px solid #fecaca;
            border-radius: 6px;
            background: #fee2e2;
            color: #991b1b;
            font-size: 14px;
        }

        .link-row {
            margin-top: 18px;
            text-align: center;
            font-size: 14px;
        }

        .link-row a {
            color: #212121;
            text-decoration: none;
            font-weight: 500;
        }

        .link-row a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

<div class="box">

    <div class="title">
        忘記密碼
    </div>

    <div class="sub">
        請驗證帳號與 Email 後設定新密碼
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert">
            @TempData["Message"]
        </div>
    }

    <form method="post"
          action="@Url.Action("ForgotPassword", "Home")">

        @Html.AntiForgeryToken()

        <div class="role-row">

            <label class="role-card">
                <input type="radio"
                       name="role"
                       value="Student"
                       checked />

                我是學生
            </label>

            <label class="role-card">
                <input type="radio"
                       name="role"
                       value="Teacher" />

                我是老師
            </label>

        </div>

        <div class="fg">
            <label for="loginId">
                帳號
            </label>

            <input id="loginId"
                   type="text"
                   name="loginId"
                   placeholder="學生學號或老師教職員編號"
                   required />
        </div>

        <div class="fg">
            <label for="email">
                Email
            </label>

            <input id="email"
                   type="email"
                   name="email"
                   placeholder="請輸入註冊時使用的 Email"
                   autocomplete="email"
                   required />
        </div>

        <div class="fg">
            <label for="newPassword">
                新密碼
            </label>

            <input id="newPassword"
                   type="password"
                   name="newPassword"
                   minlength="8"
                   placeholder="至少 8 個字元"
                   autocomplete="new-password"
                   required />
        </div>

        <div class="fg">
            <label for="confirmPassword">
                確認新密碼
            </label>

            <input id="confirmPassword"
                   type="password"
                   name="confirmPassword"
                   minlength="8"
                   placeholder="再次輸入新密碼"
                   autocomplete="new-password"
                   required />
        </div>

        <button class="btn"
                type="submit">
            重設密碼
        </button>

    </form>

    <div class="link-row">

        <a href="@Url.Action("Login", "Home")">
            回登入頁
        </a>

    </div>

</div>

</body>
</html>