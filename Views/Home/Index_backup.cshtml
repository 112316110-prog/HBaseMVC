                        function showAddPage(pageNumber) {
                            const mainRow = document.getElementById('main-row');

                            if (mainRow) {
                                document.querySelectorAll('.wizard-row')
                                    .forEach(function(input) {
                                        input.value = mainRow.value.trim();
                                    });
                            }
                            const pages =
                                document.querySelectorAll(
                                    '.add-form-page'
                                );

                            if (!pages.length) {
                                console.error(
                                    '找不到新增資料頁面'
                                );
                                return;
                            }

                            pages.forEach(function(page) {
                                page.classList.remove('active');
                            });

                            const targetPage =
                                document.getElementById(
                                    `add-form-page-${pageNumber}`
                                );

                            if (!targetPage) {
                                console.error(
                                    `找不到第 ${pageNumber} 頁`
                                );
                                return;
