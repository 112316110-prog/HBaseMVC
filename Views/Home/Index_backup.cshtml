                        function appendPatientLinkedText(
                            container,
                            content
                        ) {
                            const text =
                                String(content || '');

                            if (
                                !Array.isArray(knownPatientIds)
                                ||
                                knownPatientIds.length === 0
                            ) {
                                container.textContent = text;
                                return;
                            }

                            let position = 0;

                            while (position < text.length) {
                                let nearestIndex = -1;
                                let nearestId = '';

                                for (const patientId of knownPatientIds) {
                                    if (!patientId) {
                                        continue;
                                    }

                                    const index =
                                        text
                                            .toLowerCase()
                                            .indexOf(
                                                patientId.toLowerCase(),
                                                position
                                            );

                                    if (
                                        index !== -1
                                        &&
                                        (
                                            nearestIndex === -1
                                            ||
                                            index < nearestIndex
                                            ||
                                            (
                                                index === nearestIndex
                                                &&
                                                patientId.length > nearestId.length
                                            )
                                        )
                                    ) {
                                        nearestIndex = index;
                                        nearestId = patientId;
                                    }
                                }

                                if (nearestIndex === -1) {
                                    container.appendChild(
                                        document.createTextNode(
                                            text.substring(position)
                                        )
                                    );
                                    break;
                                }

                                if (nearestIndex > position) {
                                    container.appendChild(
                                        document.createTextNode(
                                            text.substring(
                                                position,
                                                nearestIndex
                                            )
                                        )
                                    );
                                }

                                const actualPatientText =
                                    text.substring(
                                        nearestIndex,
                                        nearestIndex + nearestId.length
                                    );

                                const link =
                                    document.createElement('a');

                                link.textContent =
                                    actualPatientText;

                                link.href =
                                    medicalRecordBaseUrl
                                    + '?row='
                                    + encodeURIComponent(
                                        nearestId
                                    );

                                link.style.color =
                                    '#2563eb';

                                link.style.fontWeight =
                                    '600';

                                link.style.textDecoration =
                                    'underline';

                                link.style.textUnderlineOffset =
                                    '2px';

                                link.title =
                                    '開啟 '
                                    + nearestId
                                    + ' 的病歷調閱';

                                container.appendChild(link);

                                position =
                                    nearestIndex
                                    + nearestId.length;
                            }
                        }

