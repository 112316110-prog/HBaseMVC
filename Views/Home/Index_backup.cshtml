                        // ============================================================
// 人體解剖標記
// ============================================================

const BODY_IS_ADMIN =
    @(isAdmin ? "true" : "false");

const bodyCanvas =
    document.getElementById(
        'body-mark-canvas'
    );
    function syncBodyCanvasSize() {

    const image =
        document.getElementById(
            'body-template-image'
        );

    if (!bodyCanvas || !image)
        return;

    const width =
        image.clientWidth;

    const height =
        image.clientHeight;

    if (!width || !height)
        return;

    bodyCanvas.width =
        width;

    bodyCanvas.height =
        height;

    bodyCanvas.style.width =
        width + 'px';

    bodyCanvas.style.height =
        height + 'px';

    redrawBodyMarks();
}
document.addEventListener(
    'DOMContentLoaded',
    function() {

        const image =
            document.getElementById(
                'body-template-image'
            );

        if (!image)
            return;

        image.addEventListener(
            'load',
            syncBodyCanvasSize
        );

        if (image.complete) {
            syncBodyCanvasSize();
        }

        window.addEventListener(
            'resize',
            syncBodyCanvasSize
        );
    }
);
const bodyCtx =
    bodyCanvas
        ? bodyCanvas.getContext('2d')
        : null;

let bodyTool = 'x';
let bodyMarks = [];
let bodyDrawing = false;


// ------------------------------------------------------------
// 切換工具
// ------------------------------------------------------------
function setBodyTool(tool) {

    bodyTool = tool;

    if (!bodyCanvas)
        return;

    if (tool === 'draw') {
        bodyCanvas.style.cursor = 'crosshair';
    }
    else if (tool === 'x') {
        bodyCanvas.style.cursor = 'crosshair';
    }
}


// ------------------------------------------------------------
// 取得滑鼠在 Canvas 的真正座標
// ------------------------------------------------------------
function getBodyCanvasPoint(e) {

    const rect =
        bodyCanvas.getBoundingClientRect();

    return {
        x:
            (e.clientX - rect.left) *
            bodyCanvas.width /
            rect.width,

        y:
            (e.clientY - rect.top) *
            bodyCanvas.height /
            rect.height
    };
}


// ------------------------------------------------------------
// 畫 X
// ------------------------------------------------------------
function drawBodyX(x, y) {

    if (!bodyCtx)
        return;

    const size = 14;

    bodyCtx.beginPath();

    bodyCtx.moveTo(
        x - size,
        y - size
    );

    bodyCtx.lineTo(
        x + size,
        y + size
    );

    bodyCtx.moveTo(
        x + size,
        y - size
    );

    bodyCtx.lineTo(
        x - size,
        y + size
    );

    bodyCtx.strokeStyle =
        '#dc2626';

    bodyCtx.lineWidth = 4;

    bodyCtx.lineCap =
        'round';

    bodyCtx.stroke();
}


// ------------------------------------------------------------
// 點一下產生 X
// ------------------------------------------------------------
if (bodyCanvas) {

    bodyCanvas.addEventListener(
        'click',
        function(e) {

            if (!BODY_IS_ADMIN)
                return;

            if (bodyTool !== 'x')
                return;

            const p =
                getBodyCanvasPoint(e);

            drawBodyX(
                p.x,
                p.y
            );

            bodyMarks.push({
                type: 'x',

                x:
                    p.x /
                    bodyCanvas.width,

                y:
                    p.y /
                    bodyCanvas.height
            });
        }
    );
}


// ------------------------------------------------------------
// 自由畫筆：開始
// ------------------------------------------------------------
if (bodyCanvas) {

    bodyCanvas.addEventListener(
        'mousedown',
        function(e) {

            if (!BODY_IS_ADMIN)
                return;

            if (bodyTool !== 'draw')
                return;

            bodyDrawing = true;

            const p =
                getBodyCanvasPoint(e);

            bodyCtx.beginPath();

            bodyCtx.moveTo(
                p.x,
                p.y
            );

            bodyMarks.push({
                type: 'stroke',

                points: [
                    {
                        x:
                            p.x /
                            bodyCanvas.width,

                        y:
                            p.y /
                            bodyCanvas.height
                    }
                ]
            });
        }
    );


    // --------------------------------------------------------
    // 自由畫筆：移動
    // --------------------------------------------------------
    bodyCanvas.addEventListener(
        'mousemove',
        function(e) {

            if (!bodyDrawing)
                return;

            if (bodyTool !== 'draw')
                return;

            const p =
                getBodyCanvasPoint(e);

            bodyCtx.lineTo(
                p.x,
                p.y
            );

            bodyCtx.strokeStyle =
                '#dc2626';

            bodyCtx.lineWidth = 4;

            bodyCtx.lineCap =
                'round';

            bodyCtx.lineJoin =
                'round';

            bodyCtx.stroke();


            const stroke =
                bodyMarks[
                    bodyMarks.length - 1
                ];

            if (
                stroke &&
                stroke.type === 'stroke'
            ) {
                stroke.points.push({
                    x:
                        p.x /
                        bodyCanvas.width,

                    y:
                        p.y /
                        bodyCanvas.height
                });
            }
        }
    );


    bodyCanvas.addEventListener(
        'mouseup',
        function() {

            bodyDrawing = false;
        }
    );


    bodyCanvas.addEventListener(
        'mouseleave',
        function() {

            bodyDrawing = false;
        }
    );
}


// ------------------------------------------------------------
// 清除全部
// ------------------------------------------------------------
function clearBodyMarks() {

    if (!BODY_IS_ADMIN)
        return;

    if (!bodyCanvas ||
        !bodyCtx)
        return;

    bodyMarks = [];

    bodyCtx.clearRect(
        0,
        0,
        bodyCanvas.width,
        bodyCanvas.height
    );
}


// ------------------------------------------------------------
// 重新畫出所有標記
// ------------------------------------------------------------
function redrawBodyMarks() {

    if (!bodyCanvas ||
        !bodyCtx)
        return;

    bodyCtx.clearRect(
        0,
        0,
        bodyCanvas.width,
        bodyCanvas.height
    );


    bodyMarks.forEach(
        function(mark) {

            // X 標記
            if (
                mark.type === 'x'
            ) {

                drawBodyX(
                    mark.x *
                    bodyCanvas.width,

                    mark.y *
                    bodyCanvas.height
                );

                return;
            }


            // 自由畫筆
            if (
                mark.type === 'stroke' &&
                Array.isArray(
                    mark.points
                ) &&
                mark.points.length > 0
            ) {

                bodyCtx.beginPath();

                bodyCtx.moveTo(
                    mark.points[0].x *
                        bodyCanvas.width,

                    mark.points[0].y *
                        bodyCanvas.height
                );


                for (
                    let i = 1;
                    i <
                    mark.points.length;
                    i++
                ) {

                    bodyCtx.lineTo(
                        mark.points[i].x *
                            bodyCanvas.width,

                        mark.points[i].y *
                            bodyCanvas.height
                    );
                }


                bodyCtx.strokeStyle =
                    '#dc2626';

                bodyCtx.lineWidth = 4;

                bodyCtx.lineCap =
                    'round';

                bodyCtx.lineJoin =
                    'round';

                bodyCtx.stroke();
            }
        }
    );
}
