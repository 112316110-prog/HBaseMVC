                    ? data.videos
                    : [];

            const patientReferences =
                Array.isArray(data.patientReferences)
                    ? data.patientReferences
                    : [];

appendAiMessage(
    'assistant',
    answer,
    images,
    patientReferences,
    videos
);

aiConversation.push({
    role: 'assistant',
    content: answer
});

aiDisplayMessages.push({
    role: 'assistant',
    content: answer,
    images: images,
    patientReferences: patientReferences,
    videos: videos
});

trimAiConversation();
saveAiChatState();          
statusElement.textContent = '';
                            } catch (error) {
                                console.error(error);

                                const isTimeout =
                                    error?.name === 'AbortError';

                                const errorMessage =
                                    isTimeout
                                        ? 'AI 回應逾時，請稍後再試。'
                                        : (
                                            error?.message
                                            || 'AI 問答失敗。'
                                        );

                                appendAiMessage(
                                    'assistant',
                                    errorMessage
                                );

                                statusElement.textContent =
                                    errorMessage;

                                statusElement.classList.add('ai-error');

                                if (
                                    aiConversation.length > 0 &&
                                    aiConversation[
                                        aiConversation.length - 1
                                    ].role === 'user'
                                ) {
                                    aiConversation.pop();
                                }
                                if (
    aiDisplayMessages.length > 0 &&
    aiDisplayMessages[
        aiDisplayMessages.length - 1
    ].role === 'user'
) {
    aiDisplayMessages.pop();
}

saveAiChatState();
                            } finally {
                                sendButton.disabled = false;
                                questionInput.disabled = false;
                                questionInput.focus();
                            }
                        }
                        function appendAiMessage(
                            role,
                            content,
                            images = [],
                            patientReferences = [],
                            videos = []
                        ) {
                            const chatBox =
                                document.getElementById(
                                    'ai-chat-box'
                                );

                            if (!chatBox) {
                                console.error(
                                    '找不到 ai-chat-box'
                                );

                                return;
                            }

                            const welcome =
                                document.getElementById(
                                    'ai-welcome'
                                );

                            if (welcome) {
                                welcome.remove();
                            }

                            const messageElement =
                                document.createElement(
                                    'div'
                                );

                            messageElement.className =
                                'ai-message ' + role;

                            const bubbleElement =
                                document.createElement(
                                    'div'
                                );

                                        bubbleElement.className =
                            'ai-bubble';

                        if (role === 'assistant') {

                            appendPatientLinkedText(
                                bubbleElement,
                                content
                            );

                        }
                        else {

                            bubbleElement.textContent =
                                content || '';

                        }

                            messageElement.appendChild(
                                bubbleElement
                            );
                            if (
                                role === 'assistant'
                                &&
                                Array.isArray(patientReferences)
                                &&
                                patientReferences.length > 0
                            ) {
                                appendAiPatientReferences(
                                    messageElement,
                                    patientReferences
                                );
                            }
                            if (
                                role === 'assistant'
                                &&
                                Array.isArray(videos)
                                &&
                                videos.length > 0
                            ) {
                                appendAiVideoGallery(
                                    messageElement,
                                    videos
                                );
                            }
                            if (
                                role === 'assistant'
                                &&
                                Array.isArray(images)
                                &&
                                images.length > 0
                            ) {
                                appendAiImageGallery(
                                    messageElement,
                                    images
                                );
                            }

                            chatBox.appendChild(
                                messageElement
                            );

                            chatBox.scrollTop =
                                chatBox.scrollHeight;
                        }
                        function appendAiVideoGallery(
