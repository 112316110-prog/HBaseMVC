@using Microsoft.AspNetCore.Http
@model List<HBaseMVC.Models.Cadaver>

@{
    ViewBag.Title = "病理教學系統";
    var edit = ViewBag.EditData as HBaseMVC.Models.Cadaver;
    var formData =
    ViewBag.PatientFormData as Dictionary<string, string>
    ?? new Dictionary<string, string>();

    string FormValue(string key, string editValue = "")
    {
        return formData.ContainsKey(key)
            ? formData[key]
            : editValue;
    }
    bool hasData = Model != null && Model.Count > 0;

    string role = Context.Session.GetString("Role") ?? "";

    bool isAdmin = role == "Admin";
    bool isTeacher = role == "Teacher" || role == "Admin";
    bool isStudent = role == "Student";

    string roleDisplay = role switch
    {
        "Admin" => "管理員",
        "Teacher" => "老師",
        "Student" => "學生",
        _ => "未知身分"
    };
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&family=Noto+Sans+TC:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
            :root {
                --bg: #ffffff;
                --bg2: #ffffff;
                --bg3: #f4f4f4;
                --sidebar-bg: #f7f7f8;
                --panel-bg: #ffffff;
                --input-bg: #f4f4f4;
                --border: #e5e5e5;
                --border2: #d4d4d4;
                --text: #212121;
                --text2: #676767;
                --text3: #969696;
                --accent: #10a37f;
                --accent2: #0d8f70;
                --success: #10a37f;
                --success-bg: rgba(16, 163, 127, 0.1);
                --info: #2563eb;
                --info-bg: rgba(37, 99, 235, 0.08);
                --red: #dc2626;
                --red-bg: rgba(220, 38, 38, 0.08);
                --radius: 10px;
                --radius-lg: 16px;
                --sidebar-width: 260px;
                --content-width: 900px;
                --shadow: 0 0 0 1px rgba(0, 0, 0, 0.04), 0 4px 18px rgba(0, 0, 0, 0.06);
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: 'Noto Sans TC', sans-serif;
                font-weight: 300;
                font-size: 14px;
                line-height: 1.7;
                min-height: 100vh;
            }

            /* ───── Layout ───── */
            .shell {
                min-height: 100vh;
                background: var(--bg);
            }

            /* ───── Sidebar ───── */
            .sidebar {
                position: fixed;
                top: 0;
                left: calc(var(--sidebar-width) * -1);
                z-index: 200;
                width: var(--sidebar-width);
                height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 12px;
                background: var(--sidebar-bg);
                border-right: 1px solid var(--border);
                overflow-y: auto;
                transition: left 0.22s ease, box-shadow 0.22s ease;
            }

                .sidebar.open {
                    left: 0;
                    box-shadow: 8px 0 30px rgba(0, 0, 0, 0.12);
                }

            .sidebar-section {
                padding: 18px 10px 7px;
                color: var(--text3);
                font-size: 11px;
                font-weight: 500;
                letter-spacing: 0.8px;
            }

            .nav-item {
                min-height: 42px;
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 9px 11px;
                margin-bottom: 2px;
                border: 0;
                border-radius: 9px;
                color: var(--text);
                font-size: 14px;
                font-weight: 400;
                text-decoration: none;
                cursor: pointer;
                user-select: none;
                transition: background 0.15s;
            }

                .nav-item:hover {
                    background: #ececec;
                    color: var(--text);
                    text-decoration: none;
                }

                .nav-item.active {
                    background: #e7e7e7;
                    color: var(--text);
                }

            .nav-icon {
                width: 18px;
                height: 18px;
                opacity: 0.75;
                flex-shrink: 0;
            }

            .nav-item.active .nav-icon {
                opacity: 1;
            }

            /* ───── Main ───── */
            .main {
                min-width: 0;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                background: var(--bg);
            }

            /* ───── Panels ───── */
            .panel {
                display: none;
                padding: 28px;
                animation: fadeIn 0.2s ease;
            }

                .panel.active {
                    display: block;
                }
            /* ───── 新增資料分頁 ───── */
            .add-form-page {
                display: none;
            }

                .add-form-page.active {
                    display: block;
                }

            .add-page-actions {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 10px;
                margin-top: 18px;
            }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(6px);
                }

                to {
                    opacity: 1;
                    transform: none;
                }
            }

            .panel-header {
                display: flex;
                align-items: baseline;
                gap: 14px;
                margin-bottom: 24px;
                padding-bottom: 16px;
                border-bottom: 1px solid var(--border);
            }

            .panel-title {
                font-family: 'Noto Serif TC', serif;
                font-size: 20px;
                font-weight: 600;
                color: var(--text);
            }

            .panel-sub {
                font-size: 12px;
                color: var(--text3);
            }

            /* ───── Cards ───── */
            .card {
                background: var(--bg2);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 20px 22px;
                margin-bottom: 16px;
            }

            .card-title {
                font-size: 12px;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: var(--accent);
                margin-bottom: 14px;
            }

            /* ───── Form ───── */
            .form-grid {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                align-items: flex-end;
            }

            .fg {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

                .fg label {
                    font-size: 11px;
                    color: var(--text3);
                    letter-spacing: 0.5px;
                }

                .fg input, .fg select, .fg textarea {
                    height: 34px;
                    padding: 0 10px;
                    background: var(--bg3);
                    border: 1px solid var(--border2);
                    border-radius: var(--radius);
                    color: var(--text);
                    font-size: 13px;
                    font-family: inherit;
                    outline: none;
                    transition: border-color 0.15s;
                }

                    .fg input:focus, .fg select:focus, .fg textarea:focus {
                        border-color: var(--accent);
                    }

                .fg textarea {
                    min-height: 80px;
                    padding: 8px 10px;
                    background: var(--bg3);
                    border: 1px solid var(--border2);
                    border-radius: var(--radius);
                    color: var(--text);
                    font-size: 13px;
                    font-family: inherit;
                    outline: none;
                    resize: vertical;
                }

                .fg input::placeholder {
                    color: var(--text3);
                }

                .fg select option {
                    background: var(--bg3);
                }

            /* ───── Buttons ───── */
            .btn {
                min-height: 36px;
                padding: 0 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--border2);
                border-radius: 9px;
                background: white;
                color: var(--text);
                font: inherit;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
                cursor: pointer;
                white-space: nowrap;
                transition: background 0.15s, border-color 0.15s;
            }

                .btn:hover {
                    background: #f1f1f1;
                    border-color: #c7c7c7;
                    color: var(--text);
                }

            .btn-primary {
                background: var(--text);
                border-color: var(--text);
                color: white;
            }

                .btn-primary:hover {
                    background: #000;
                    border-color: #000;
                    color: white;
                }

            .btn-danger {
                color: var(--red);
                border-color: #efcaca;
            }

                .btn-danger:hover {
                    background: #fff1f1;
                    color: var(--red);
                }

            .btn-success {
                color: var(--accent);
                border-color: rgba(16, 163, 127, 0.35);
            }

                .btn-success:hover {
                    background: var(--success-bg);
                    color: var(--accent);
                }

            .btn-info {
                color: var(--info);
                border-color: rgba(37, 99, 235, 0.3);
            }

                .btn-info:hover {
                    background: var(--info-bg);
                    color: var(--info);
                }

            .btn-sm {
                min-height: 30px;
                padding: 0 10px;
                font-size: 12px;
            }

            .btn-xs {
                min-height: 28px;
                padding: 0 9px;
                font-size: 11px;
            }

            /* 功能欄按鈕排列 */
            .table-actions {
                display: flex;
                align-items: center;
                gap: 4px;
                flex-wrap: nowrap;
                white-space: nowrap;
            }

                .table-actions .btn {
                    flex-shrink: 0;
                }

            /* 功能欄寬度 */
            thead th:last-child,
            tbody td:last-child {
                min-width: 330px;
            }
            /* 解剖狀態 */
            thead th:nth-child(5),
            tbody td:nth-child(5) {
                min-width: 90px;
                text-align: center;
            }

            /* 圖片、影片欄置中 */
            thead th:nth-child(6),
            tbody td:nth-child(6),
            thead th:nth-child(7),
            tbody td:nth-child(7) {
                width: 60px;
                text-align: center;
            }

            /* ───── Table ───── */
            .tbl-wrap {
                overflow-x: auto;
            }

            table {
                width: 100%;
                min-width: 1100px;
                border-collapse: collapse;
                background: white;
                font-size: 13px;
            }

            thead th {
                padding: 12px 14px;
                background: #fafafa;
                border-bottom: 1px solid var(--border);
                color: var(--text2);
                font-size: 12px;
                font-weight: 500;
                letter-spacing: 0;
                text-align: left;
                text-transform: none;
                white-space: nowrap;
            }

            tbody td {
                padding: 13px 14px;
                border-bottom: 1px solid #f0f0f0;
                color: var(--text);
                vertical-align: middle;
            }

            tbody tr:hover td {
                background: #fafafa;
                color: var(--text);
            }

            /* ───── Badge ───── */
            .badge {
                display: inline-block;
                padding: 2px 8px;
                border-radius: 3px;
                font-size: 11px;
                font-weight: 500;
            }

            .badge-alive {
                background: var(--red-bg);
                color: #e05c4a;
                border: 1px solid rgba(192,57,43,0.3);
            }

            .badge-dead {
                background: var(--bg3);
                color: var(--text3);
                border: 1px solid var(--border2);
            }

            .badge-count {
                background: var(--info-bg);
                color: #6a9fd0;
                border: 1px solid rgba(74,127,192,0.3);
                font-size: 12px;
            }

            /* ───── Alert ───── */
            .alert {
                padding: 10px 16px;
                border-radius: var(--radius);
                margin-bottom: 16px;
                font-size: 13px;
                background: var(--info-bg);
                border: 1px solid rgba(74,127,192,0.3);
                color: #6a9fd0;
            }

            /* ───── Empty State ───── */
            .empty-state {
                text-align: center;
                padding: 60px 20px;
                color: var(--text3);
            }

            .empty-state-icon {
                font-size: 40px;
                margin-bottom: 12px;
                opacity: 0.3;
            }

            .empty-state-title {
                font-size: 15px;
                color: var(--text2);
                margin-bottom: 6px;
            }

            .empty-state-sub {
                font-size: 13px;
            }

            /* ───── Image Panel ───── */
            .img-row {
                display: grid;
                grid-template-columns: 200px 1fr;
                gap: 20px;
                padding: 20px 0;
                border-bottom: 1px solid var(--border);
            }

                .img-row:last-child {
                    border-bottom: none;
                }

            .img-frame {
                position: relative;
                width: 200px;
                flex-shrink: 0;
            }

                .img-frame img {
                    width: 200px;
                    display: block;
                    border-radius: var(--radius);
                    border: 1px solid var(--border2);
                }

                .img-frame canvas {
                    position: absolute;
                    top: 0;
                    left: 0;
                    border-radius: var(--radius);
                    z-index: 10;
                    pointer-events: none;
                }

            .img-meta {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

            .img-note {
                background: var(--bg3);
                border: 1px solid var(--border);
                border-left: 3px solid var(--accent);
                border-radius: var(--radius);
                padding: 10px 14px;
                font-size: 13px;
                color: var(--text2);
                line-height: 1.8;
            }

            .anno-bar {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                align-items: center;
            }

                .anno-bar input {
                    height: 28px;
                    padding: 0 10px;
                    background: var(--bg3);
                    border: 1px solid var(--border2);
                    border-radius: var(--radius);
                    color: var(--text);
                    font-size: 12px;
                    font-family: inherit;
                    outline: none;
                    width: 140px;
                }

                    .anno-bar input:focus {
                        border-color: var(--accent);
                    }

            /* ───── Upload section ───── */
            .upload-zone {
                border: 1px dashed var(--border2);
                border-radius: var(--radius);
                padding: 20px;
                text-align: center;
                color: var(--text3);
                font-size: 13px;
                transition: border-color 0.15s;
                cursor: pointer;
            }

                .upload-zone:hover {
                    border-color: var(--accent);
                    color: var(--text2);
                }

            .upload-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
                margin-bottom: 16px;
            }

            .notes-tbl {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

                .notes-tbl th {
                    font-size: 10px;
                    letter-spacing: 1px;
                    color: var(--text3);
                    text-transform: uppercase;
                    padding: 4px 6px 8px;
                    text-align: left;
                    border-bottom: 1px solid var(--border);
                }

                .notes-tbl td {
                    padding: 5px 4px;
                }

                .notes-tbl .idx {
                    color: var(--text3);
                    font-size: 12px;
                    width: 26px;
                    text-align: center;
                }

                .notes-tbl input, .notes-tbl select {
                    width: 100%;
                    height: 30px;
                    padding: 0 10px;
                    background: var(--bg3);
                    border: 1px solid var(--border2);
                    border-radius: var(--radius);
                    color: var(--text);
                    font-size: 12px;
                    font-family: inherit;
                    outline: none;
                }

                    .notes-tbl input:focus, .notes-tbl select:focus {
                        border-color: var(--accent);
                    }

                    .notes-tbl select option {
                        background: var(--bg3);
                    }

            /* ───── Modal ───── */
            .modal-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.6);
                z-index: 999;
                align-items: center;
                justify-content: center;
            }

                .modal-overlay.open {
                    display: flex;
                }

            .modal {
                background: var(--bg2);
                border: 1px solid var(--border2);
                border-radius: var(--radius-lg);
                width: 480px;
                max-width: 95vw;
                animation: fadeIn 0.2s ease;
            }

            .modal-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 20px;
                border-bottom: 1px solid var(--border);
            }

            .modal-title {
                font-family: 'Noto Serif TC', serif;
                font-size: 15px;
                font-weight: 600;
                color: var(--accent);
            }

            .modal-body {
                padding: 20px;
            }

            .modal-form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

                .modal-form-grid .full {
                    grid-column: 1 / -1;
                }

            .modal-footer {
                display: flex;
                justify-content: flex-end;
                gap: 8px;
                padding: 14px 20px;
                border-top: 1px solid var(--border);
            }

            /* ───── Delete confirm ───── */
            .confirm-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.6);
                z-index: 1000;
                align-items: center;
                justify-content: center;
            }

                .confirm-overlay.open {
                    display: flex;
                }

            .confirm-box {
                background: var(--bg2);
                border: 1px solid var(--border2);
                border-radius: var(--radius-lg);
                padding: 28px 28px 20px;
                width: 340px;
                text-align: center;
            }

                .confirm-box p {
                    color: var(--text2);
                    font-size: 14px;
                    margin-bottom: 20px;
                }

                .confirm-box strong {
                    color: var(--accent);
                }

            /* ───── Scrollbar ───── */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: var(--border2);
                border-radius: 3px;
            }

            /* ───── Responsive ───── */
            @@media (max-width: 768px) {
                .record-import-controls {
                    align-items: stretch;
                    flex-direction: column;
                }

                .record-file-label,
                .record-import-button {
                    width: 100%;
                }

                .shell {
                    display: block;
                }

                .sidebar {
                    position: fixed;
                    left: -280px;
                    top: 0;
                    z-index: 100;
                    width: var(--sidebar-width);
                    height: 100vh;
                    display: flex;
                    transition: left 0.2s ease;
                }

                    .sidebar.open {
                        left: 0;
                    }

                .mobile-menu-button {
                    display: grid;
                    place-items: center;
                }

                .chat-composer-wrap {
                    left: 0;
                }

                .panel {
                    padding: 22px 16px 70px;
                }

                .prompt-suggestions {
                    grid-template-columns: 1fr;
                }

                .chat-welcome {
                    margin-top: 5vh;
                }

                    .chat-welcome h1 {
                        font-size: 23px;
                    }

                .upload-grid {
                    grid-template-columns: 1fr;
                }

                .img-row {
                    grid-template-columns: 1fr;
                }
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--bg);
                color: var(--text);
                font-family: "Noto Sans TC", "Segoe UI", sans-serif;
                font-size: 15px;
                font-weight: 400;
                line-height: 1.65;
            }

            .panel {
                display: none;
                width: 100%;
                max-width: 1240px;
                margin: 0 auto;
                padding: 30px 32px 80px;
                animation: fadeIn 0.2s ease;
            }

                .panel.active {
                    display: block;
                }

            .panel-header {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 22px;
                padding-bottom: 16px;
                border-bottom: 1px solid var(--border);
            }

            .panel-title {
                color: var(--text);
                font-family: inherit;
                font-size: 22px;
                font-weight: 600;
            }

            .panel-sub {
                color: var(--text3);
                font-size: 12px;
            }

            .card {
                padding: 20px 22px;
                margin-bottom: 18px;
                background: white;
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
            }

            .card-title {
                margin-bottom: 16px;
                color: var(--text);
                font-size: 15px;
                font-weight: 600;
                letter-spacing: 0;
                text-transform: none;
            }

            .notes-tbl {
                min-width: 0 !important;
            }

            /* ───── AI Assistant ───── */
            #panel-ai {
                max-width: none;
                padding: 0;
            }

            .chat-page {
                height: calc(100vh - 58px);
                display: flex;
                flex-direction: column;
                background: white;
            }

            .chat-scroll-area {
                flex: 1;
                overflow-y: auto;
                padding: 32px 20px 180px;
            }

            .chat-welcome {
                width: min(780px, 100%);
                margin: 10vh auto 0;
                text-align: center;
            }

            .chat-logo {
                width: 48px;
                height: 48px;
                display: grid;
                place-items: center;
                margin: 0 auto 22px;
                border-radius: 50%;
                background: var(--accent);
                color: white;
                font-size: 21px;
                font-weight: 600;
            }

            .chat-welcome h1 {
                margin: 0 0 9px;
                color: var(--text);
                font-size: 28px;
                font-weight: 600;
            }

            .chat-welcome p {
                margin: 0;
                color: var(--text2);
                font-size: 14px;
            }

            .prompt-suggestions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 11px;
                margin-top: 30px;
            }

                .prompt-suggestions button {
                    min-height: 82px;
                    padding: 14px 16px;
                    border: 1px solid var(--border);
                    border-radius: 14px;
                    background: white;
                    color: var(--text);
                    font: inherit;
                    font-size: 13px;
                    line-height: 1.55;
                    text-align: left;
                    cursor: pointer;
                    transition: background 0.15s, border-color 0.15s;
                }

                    .prompt-suggestions button:hover {
                        background: #f7f7f7;
                        border-color: var(--border2);
                    }

                    .prompt-suggestions button span {
                        display: block;
                        margin-bottom: 5px;
                        color: var(--text2);
                        font-size: 11px;
                        font-weight: 600;
                    }

            .ai-message {
                width: min(780px, 100%);
                display: grid;
                grid-template-columns: 36px minmax(0, 1fr);
                gap: 14px;
                margin: 0 auto;
                padding: 22px 0;
            }

                .ai-message + .ai-message {
                    border-top: 1px solid #f0f0f0;
                }

                .ai-message::before {
                    width: 34px;
                    height: 34px;
                    display: grid;
                    place-items: center;
                    border-radius: 50%;
                    font-size: 12px;
                    font-weight: 600;
                }

                .ai-message.user::before {
                    content: "你";
                    background: #dedede;
                    color: #333;
                }

                .ai-message.assistant::before {
                    content: "AI";
                    background: var(--accent);
                    color: white;
                }

                .ai-message.system::before {
                    content: "系";
                    background: #e6eefc;
                    color: #2563eb;
                }

            .ai-bubble {
                max-width: none;
                padding: 3px 0;
                background: transparent;
                border: 0;
                border-radius: 0;
                color: var(--text);
                font-size: 15px;
                line-height: 1.85;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }

            .chat-composer-wrap {
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 40;
                padding: 24px 20px 12px;
                background: linear-gradient( to top, white 72%, rgba(255, 255, 255, 0) );
            }

            .chat-composer {
                width: min(780px, 100%);
                min-height: 58px;
                display: flex;
                align-items: flex-end;
                gap: 10px;
                margin: 0 auto;
                padding: 10px 10px 10px 17px;
                border: 1px solid var(--border2);
                border-radius: 25px;
                background: white;
                box-shadow: var(--shadow);
            }

                .chat-composer textarea {
                    flex: 1;
                    min-height: 30px;
                    max-height: 180px;
                    padding: 4px 0;
                    border: 0;
                    outline: 0;
                    resize: none;
                    background: transparent;
                    color: var(--text);
                    font: inherit;
                    font-size: 15px;
                    line-height: 1.5;
                }

            .chat-send-button {
                width: 38px;
                height: 38px;
                flex-shrink: 0;
                display: grid;
                place-items: center;
                border: 0;
                border-radius: 50%;
                background: var(--text);
                color: white;
                font-size: 20px;
                cursor: pointer;
            }

                .chat-send-button:hover {
                    background: #000;
                }

                .chat-send-button:disabled {
                    background: #cfcfcf;
                    cursor: not-allowed;
                }


            .ai-patient-references {
                grid-column: 2;
                width: 100%;
                margin-top: 10px;
            }

            .ai-patient-reference {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 8px;
                width: 100%;
                padding: 10px 12px;
                margin-bottom: 8px;
                background: #fafafa;
                border: 1px solid var(--border);
                border-radius: 10px;
            }

            .ai-image-gallery {
                grid-column: 2;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 12px;
                width: 100%;
                margin-top: 10px;
            }

            .ai-video-gallery {
                grid-column: 2;
                width: 100%;
                display: grid;
                gap: 12px;
                margin-top: 10px;
            }

            .ai-video-card {
                width: 100%;
                padding: 14px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: #fafafa;
            }

            .ai-video-title {
                margin-bottom: 6px;
                color: var(--text);
                font-size: 14px;
                font-weight: 600;
            }

            .ai-video-meta {
                margin-bottom: 3px;
                color: var(--text2);
                font-size: 12px;
            }

            .ai-video-note {
                margin-top: 7px;
                margin-bottom: 10px;
                color: var(--text2);
                font-size: 12px;
                line-height: 1.5;
            }

            .ai-video-link {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 34px;
                padding: 0 12px;
                border-radius: 8px;
                background: var(--text);
                color: #ffffff;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
            }

                .ai-video-link:hover {
                    background: #000000;
                    color: #ffffff;
                    text-decoration: none;
                }

            .ai-image-card {
                overflow: hidden;
                border: 1px solid var(--border);
                border-radius: 12px;
                background: #ffffff;
            }

            .ai-image-link {
                display: block;
                background: #111111;
                text-decoration: none;
            }

            .ai-result-image {
                display: block;
                width: 100%;
                height: 240px;
                object-fit: contain;
                background: #111111;
            }

            .ai-image-meta {
                padding: 10px 12px;
            }

            .ai-image-title {
                color: var(--text);
                font-size: 13px;
                font-weight: 600;
            }

            .ai-image-patient {
                margin-top: 3px;
                color: var(--text2);
                font-size: 12px;
            }

            .ai-image-note {
                margin-top: 6px;
                color: var(--text3);
                font-size: 12px;
                line-height: 1.5;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }

            .ai-image-badge {
                display: inline-flex;
                align-items: center;
                min-height: 22px;
                margin-top: 7px;
                padding: 0 8px;
                border-radius: 999px;
                background: #f1f1f1;
                color: var(--text2);
                font-size: 11px;
            }

            .ai-status {
                width: min(780px, 100%);
                min-height: 21px;
                margin: 5px auto 0;
                color: var(--text3);
                font-size: 12px;
                text-align: center;
            }

            .ai-error {
                color: var(--red);
            }

            .chat-disclaimer {
                width: min(780px, 100%);
                margin: 2px auto 0;
                color: var(--text3);
                font-size: 11px;
                text-align: center;
            }

            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 8px 8px 18px;
            }

            .brand-icon {
                width: 36px;
                height: 36px;
                display: grid;
                place-items: center;
                border-radius: 10px;
                background: var(--accent);
                color: white;
                font-size: 18px;
                font-weight: 600;
            }

            .brand-title {
                color: var(--text);
                font-size: 14px;
                font-weight: 600;
            }

            .brand-subtitle {
                margin-top: 1px;
                color: var(--text3);
                font-size: 11px;
            }

            .new-chat-button {
                width: 100%;
                min-height: 43px;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 0 12px;
                margin-bottom: 12px;
                border: 1px solid var(--border2);
                border-radius: 10px;
                background: white;
                color: var(--text);
                font: inherit;
                font-size: 14px;
                font-weight: 500;
                cursor: pointer;
                transition: background 0.15s;
            }

                .new-chat-button:hover {
                    background: #eeeeee;
                }

            .new-chat-plus {
                font-size: 21px;
                font-weight: 300;
            }

            .sidebar-spacer {
                flex: 1;
            }

            .account-card {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 12px 8px 4px;
                margin-top: 14px;
                border-top: 1px solid var(--border);
            }

            .account-avatar {
                width: 34px;
                height: 34px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                background: #dedede;
                color: #333;
                font-size: 13px;
                font-weight: 600;
            }

            .account-info {
                flex: 1;
                min-width: 0;
            }

            .account-name {
                font-size: 13px;
                font-weight: 500;
            }

            .account-id {
                overflow: hidden;
                color: var(--text3);
                font-size: 11px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .account-logout {
                color: var(--text2);
                font-size: 12px;
                text-decoration: none;
            }

                .account-logout:hover {
                    color: var(--red);
                }

            .main {
                min-width: 0;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                background: var(--bg);
            }

            .app-header {
                position: sticky;
                top: 0;
                z-index: 50;
                height: 58px;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 22px;
                background: rgba(255, 255, 255, 0.92);
                border-bottom: 1px solid var(--border);
                backdrop-filter: blur(10px);
            }

            .mobile-menu-button {
                width: 36px;
                height: 36px;
                display: grid;
                place-items: center;
                border: 0;
                border-radius: 9px;
                background: transparent;
                color: var(--text);
                font-size: 20px;
                cursor: pointer;
            }

                .mobile-menu-button:hover {
                    background: var(--input-bg);
                }

            .app-header-title {
                font-size: 15px;
                font-weight: 600;
            }

            .app-header-actions {
                margin-left: auto;
            }

            .system-status {
                display: flex;
                align-items: center;
                gap: 7px;
                color: var(--text2);
                font-size: 12px;
            }

            .status-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--accent);
            }

            .medical-record-import {
                width: min(780px, calc(100% - 40px));
                margin: 18px auto 0;
                padding: 14px 16px;
                background: #fafafa;
                border: 1px solid var(--border);
                border-radius: 14px;
            }

            .record-import-header {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 12px;
            }

            .record-import-title {
                color: var(--text);
                font-size: 14px;
                font-weight: 600;
            }

            .record-import-subtitle {
                margin-top: 2px;
                color: var(--text3);
                font-size: 11px;
            }

            .record-clear-button {
                margin-left: auto;
                padding: 5px 10px;
                border: 0;
                border-radius: 8px;
                background: transparent;
                color: var(--text2);
                font: inherit;
                font-size: 12px;
                cursor: pointer;
            }

                .record-clear-button:hover {
                    background: #ececec;
                    color: var(--text);
                }

            .record-import-controls {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .record-file-label {
                min-width: 0;
                flex: 1;
                min-height: 40px;
                display: flex;
                align-items: center;
                padding: 0 12px;
                border: 1px solid var(--border2);
                border-radius: 10px;
                background: white;
                color: var(--text2);
                font-size: 13px;
                cursor: pointer;
            }

                .record-file-label:hover {
                    border-color: #bdbdbd;
                }

                .record-file-label input {
                    display: none;
                }

            #medical-record-file-name {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .record-import-button {
                min-height: 40px;
                padding: 0 15px;
                border: 0;
                border-radius: 10px;
                background: var(--text);
                color: white;
                font: inherit;
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
            }

                .record-import-button:hover {
                    background: #000;
                }

                .record-import-button:disabled {
                    background: #cfcfcf;
                    cursor: not-allowed;
                }

            .ai-record-status {
                min-height: 20px;
                margin-top: 9px;
                color: var(--text3);
                font-size: 12px;
                white-space: pre-wrap;
            }

                .ai-record-status.success {
                    color: #16804e;
                }

                .ai-record-status.error {
                    color: var(--red);
                }

            .medical-record-preview {
                display: none;
                max-height: 180px;
                overflow: auto;
                margin-top: 10px;
                padding: 11px 12px;
                background: white;
                border: 1px solid var(--border);
                border-radius: 9px;
                color: var(--text2);
                font-family: inherit;
                font-size: 12px;
                line-height: 1.65;
                white-space: pre-wrap;
            }

                .medical-record-preview.open {
                    display: block;
                }

            .sidebar-overlay {
                position: fixed;
                inset: 0;
                z-index: 190;
                display: none;
                background: rgba(0, 0, 0, 0.28);
            }

                .sidebar-overlay.open {
                    display: block;
                }

            body.sidebar-open {
                overflow: hidden;
            }

            .ai-clear-button {
                width: fit-content;
                min-width: 0;
                align-self: flex-end;
                margin: 12px 20px 0;
                padding: 0 10px;
            }

            /* ===== 分頁 ===== */

            .add-form-page {
                display: none;
            }

                .add-form-page.active {
                    display: block;
                }

            .add-page-actions {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                gap: 10px;
                margin-top: 18px;
            }

            .import-page-grid {
                display: grid;
                gap: 18px;
            }

            #panel-add {
                max-width: 960px;
            }

                #panel-add .card {
                    max-width: none !important;
                }
            /* ===== 資料列表專用表格 ===== */

            #panel-list .tbl-wrap {
                width: 100%;
                overflow-x: auto;
            }

            #panel-list table {
                width: 100% !important;
                min-width: 1050px;
                table-layout: auto;
                border-collapse: collapse;
                background: #ffffff;
                font-size: 15px !important;
            }

            #panel-list th,
            #panel-list td {
                padding: 12px 14px !important;
                vertical-align: middle;
                white-space: nowrap;
                line-height: 1.5;
            }

            #panel-list thead th {
                background: #f8fafc !important;
                color: #475569 !important;
                font-size: 14px !important;
                font-weight: 600 !important;
                text-align: left;
                border-bottom: 1px solid #dbe1ea !important;
            }

            #panel-list tbody td {
                color: #1f2937 !important;
                font-size: 15px !important;
                border-bottom: 1px solid #e5e7eb;
            }

            #panel-list tbody tr:hover td {
                background: #f8fafc !important;
                color: #1f2937 !important;
            }

            /* 病人編號 */
            #panel-list th:nth-child(1),
            #panel-list td:nth-child(1) {
                min-width: 145px;
            }

            /* 病歷號碼 */
            #panel-list th:nth-child(2),
            #panel-list td:nth-child(2) {
                min-width: 145px;
            }

            /* 性別、血型 */
            #panel-list th:nth-child(3),
            #panel-list td:nth-child(3),
            #panel-list th:nth-child(4),
            #panel-list td:nth-child(4) {
                width: 70px;
            }

            /* 解剖狀態 */
            #panel-list th:nth-child(5),
            #panel-list td:nth-child(5) {
                min-width: 90px;
                text-align: center;
            }

            /* 圖片、影片 */
            #panel-list th:nth-child(6),
            #panel-list td:nth-child(6),
            #panel-list th:nth-child(7),
            #panel-list td:nth-child(7) {
                width: 70px;
                text-align: center;
            }

            /* 功能欄 */
            #panel-list th:nth-child(8),
            #panel-list td:nth-child(8) {
                min-width: 390px;
            }

            /* 病人編號 */
            #panel-list .td-key {
                color: var(--accent) !important;
                font-weight: 600;
            }

            /* 功能按鈕固定單行 */
            #panel-list .table-actions {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-wrap: nowrap;
                white-space: nowrap;
            }

                #panel-list .table-actions .btn {
                    flex: 0 0 auto;
                    align-self: auto;
                    min-height: 28px;
                    height: 28px;
                    padding: 0 8px;
                    font-size: 11px !important;
                }
    </style>

</head>
