                        /* ══ Canvas annotation logic ══ */
                        let drawMode = {};
                        let canvasReady = {};

                        function initCanvas(i) {
                            const canvas = document.getElementById('canvas_' + i);
                            const img = document.getElementById('img_' + i);
                            if (!canvas || !img) return;

                            const ctx = canvas.getContext('2d');
                            drawMode[i] = false;
                            canvasReady[i] = false;

                            canvas.style.pointerEvents = 'none';
                            canvas.style.cursor = 'default';

                            function resizeCanvasToImage() {
                                const rect = img.getBoundingClientRect();
                                if (rect.width === 0 || rect.height === 0) return false;
                                canvas.width = rect.width;
                                canvas.height = rect.height;
                                canvas.style.width = rect.width + 'px';
                                canvas.style.height = rect.height + 'px';
                                canvas.style.left = '0px';
                                canvas.style.top = '0px';
                                canvasReady[i] = true;
                                return true;
                            }

                            function doResize() {
                                if (!resizeCanvasToImage()) setTimeout(doResize, 100);
                            }

                            if (img.complete) doResize();
                            else img.onload = doResize;
                            window.addEventListener('resize', doResize);

                            let drawing = false, lastX = 0, lastY = 0;

                            function getPos(e) {
                                const rect = canvas.getBoundingClientRect();
                                return { x: e.clientX - rect.left, y: e.clientY - rect.top };
                            }

                            canvas.addEventListener('mousedown', function(e) {
                                if (!drawMode[i] || !canvasReady[i]) return;
                                drawing = true;
                                const p = getPos(e); lastX = p.x; lastY = p.y;
                                e.preventDefault();
                            });
                            canvas.addEventListener('mousemove', function(e) {
                                if (!drawing || !drawMode[i] || !canvasReady[i]) return;
                                const p = getPos(e);
                                ctx.beginPath();
                                ctx.moveTo(lastX, lastY);
                                ctx.lineTo(p.x, p.y);
                                ctx.strokeStyle = '#e8b84b';
                                ctx.lineWidth = 2.5;
                                ctx.lineCap = 'round';
                                ctx.lineJoin = 'round';
                                ctx.stroke();
                                lastX = p.x; lastY = p.y;
                                e.preventDefault();
                            });
                            canvas.addEventListener('mouseup', function() { drawing = false; });
                            canvas.addEventListener('mouseleave', function() { drawing = false; });
                        }

                        function toggleDraw(i) {
                            const canvas = document.getElementById('canvas_' + i);
                            const btn = document.getElementById('drawbtn_' + i);
                            if (!canvas) return;
                            drawMode[i] = !drawMode[i];
                            if (drawMode[i]) {
                                canvas.style.pointerEvents = 'auto';
                                canvas.style.cursor = 'crosshair';
                                if (btn) { btn.textContent = '停止畫圖'; btn.style.borderColor = 'var(--accent)'; btn.style.color = 'var(--accent)'; }
                            } else {
                                canvas.style.pointerEvents = 'none';
                                canvas.style.cursor = 'default';
                                if (btn) { btn.textContent = '✏ 開始畫圖'; btn.style.borderColor = ''; btn.style.color = ''; }
                            }
                        }

                        function clearCanvas(i) {
                            const canvas = document.getElementById('canvas_' + i);
                            if (!canvas) return;
                            canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
                        }

                        function addText(i) {
                            const canvas = document.getElementById('canvas_' + i);
                            const textBox = document.getElementById('text_' + i);
                            if (!canvas || !textBox) return;
                            const text = textBox.value.trim();
                            if (!text) return;
                            const ctx = canvas.getContext('2d');
                            ctx.fillStyle = '#e8b84b';
                            ctx.font = 'bold 15px "Noto Sans TC", sans-serif';
                            ctx.fillText(text, 14, 28);
                            textBox.value = '';
                        }

