function trimAiConversation() {
    const maxMessages = 12;

    if (aiConversation.length > maxMessages) {
        aiConversation =
            aiConversation.slice(
                aiConversation.length - maxMessages
            );
    }

    if (aiDisplayMessages.length > maxMessages) {
        aiDisplayMessages =
            aiDisplayMessages.slice(
                aiDisplayMessages.length - maxMessages
            );
    }
}

                        function getAntiForgeryToken() {
                            const tokenInput =
                                document.querySelector(
                                    'input[name="__RequestVerificationToken"]'
                                );

                            return tokenInput ? tokenInput.value : '';
