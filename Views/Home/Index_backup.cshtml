                                        <label>性別*</label>

                                        <select name="gender" required>
                                            <option value="">請選擇</option>

                                            <option value="男"
                                                    selected="@(currentGender == "男")">
                                                男
                                            </option>

                                            <option value="女"
                                                    selected="@(currentGender == "女")">
                                                女
                                            </option>
                                        </select>
                                    </div>

                                    <div class="fg">
                                        <label>血型*</label>

                                        <select name="bloodType" required>
                                            <option value="">請選擇</option>

                                            <option value="A"
                                                    selected="@(currentBloodType == "A")">
                                                A
                                            </option>

                                            <option value="B"
                                                    selected="@(currentBloodType == "B")">
                                                B
                                            </option>

                                            <option value="AB"
                                                    selected="@(currentBloodType == "AB")">
                                                AB
                                            </option>

                                            <option value="O"
                                                    selected="@(currentBloodType == "O")">
                                                O
                                            </option>

                                        </select>
                                    </div>

                                    <div class="fg">
                                        <label>血型資料來源*</label>

                                        <select name="bloodTypeSource" required>
                                            <option value="">請選擇</option>

                                            <option value="病人自述"
                                                    selected="@(
                                                    currentBloodTypeSource
                                                    == "病人自述"
                                                                                                                                                                                                                                                                                    )">
