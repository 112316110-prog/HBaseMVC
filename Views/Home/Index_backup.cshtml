                                output +=
                                    `完整辨識文字：\n${data.fullRawText || '無'}\n\n`;

                                const records =
                                    Array.isArray(data.records)
                                        ? data.records
                                        : [];

                                records.forEach(function(record, index) {
                                    output +=
                                        `紀錄 ${index + 1}\n`;

                                    output +=
                                        `日期：${record.recordDate || '未辨識'}\n`;

                                    output +=
                                        `時間：${record.recordTime || '未辨識'}\n`;

                                    output +=
                                        `症狀：${record.symptoms || '未辨識'}\n`;

                                    output +=
                                        `評估：${record.assessment || '未辨識'}\n`;

                                    output +=
                                        `處置：${record.treatment || '未辨識'}\n`;

                                    output +=
                                        `護理紀錄：${record.nursingNote || '未辨識'}\n`;

                                    output +=
                                        `血壓：${record.bloodPressure || '未辨識'}\n`;

                                    output +=
                                        `脈搏：${record.pulse || '未辨識'}\n`;

                                    output +=
                                        `呼吸：${record.respiratoryRate || '未辨識'}\n`;

                                    output +=
                                        `體溫：${record.temperature || '未辨識'}\n`;

                                    output +=
                                        `血氧：${record.oxygenSaturation || '未辨識'}\n`;

                                    output +=
                                        `體重：${record.bodyWeight || '未辨識'}\n`;

                                    output +=
                                        `藥物：${Array.isArray(record.medications)
                                            ? record.medications.join('、')
                                            : ''
                                        }\n`;

                                    output +=
                                        `檢驗發現：${Array.isArray(record.labFindings)
                                            ? record.labFindings.join('、')
                                            : ''
                                        }\n`;

                                    output +=
                                        `可信度：${typeof record.confidence === 'number'
                                            ? Math.round(record.confidence * 100) + '%'
                                            : '未提供'
                                        }\n`;

                                    output +=
                                        `警告：${Array.isArray(record.warnings)
                                            ? record.warnings.join('、')
                                            : ''
                                        }\n`;

                                    output +=
                                        `原始文字：\n${record.rawText || '無'}\n`;

                                    output +=
                                        '------------------------------\n';
                                });

                                if (Array.isArray(data.globalWarnings) &&
                                    data.globalWarnings.length > 0) {
                                    output +=
                                        '\n整體警告：\n' +
                                        data.globalWarnings.join('\n');
                                }

                                previewElement.textContent = output;
                                previewElement.classList.add('open');

                                statusElement.textContent =
                                    `辨識完成，共取得 ${records.length} 筆紀錄。請人工確認內容。`;

                                statusElement.className =
                                    'ai-record-status success';
                            } catch (error) {
                                console.error(error);
                                if (importButton) {
                                    importButton.disabled = true;
                                }

                                recognizedPaperMedicalRecord = null;
                                statusElement.textContent =
                                    error.message ||
                                    '紙本病歷辨識失敗。';

                                statusElement.className =
                                    'ai-record-status error';
                            } finally {
                                button.disabled = false;
                            }
                        }
