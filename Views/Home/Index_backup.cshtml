                        async function importMedicalRecord() {
                            const fileInput =
                                document.getElementById('medical-record-file');

                            const importButton =
                                document.getElementById('medical-record-import-button');

                            const statusElement =
                                document.getElementById('medical-record-status');

                            const previewElement =
                                document.getElementById('medical-record-preview');

                            if (
                                !fileInput ||
                                !importButton ||
                                !statusElement ||
                                !previewElement
                            ) {
                                console.error('電子病歷匯入介面缺少必要元素。');
                                return;
                            }

                            const file =
                                fileInput.files && fileInput.files.length > 0
                                    ? fileInput.files[0]
                                    : null;

                            if (!file) {
                                statusElement.textContent = '請先選擇電子病歷檔案。';
                                statusElement.className = 'ai-record-status error';
                                fileInput.focus();
                                return;
                            }

                            const allowedExtensions = [
                                '.txt',
                                '.csv',
                                '.json'
                            ];

                            const fileName =
                                file.name.toLowerCase();

                            const isAllowed =
                                allowedExtensions.some(
                                    extension => fileName.endsWith(extension)
                                );

                            if (!isAllowed) {
                                statusElement.textContent =
                                    '目前只支援 TXT、CSV、JSON 檔案。';

                                statusElement.className =
                                    'ai-record-status error';

                                fileInput.value = '';
                                return;
                            }

                            const maxFileSize =
                                2 * 1024 * 1024;

                            if (file.size > maxFileSize) {
                                statusElement.textContent =
                                    '檔案不可超過 2 MB。';

                                statusElement.className =
                                    'ai-record-status error';

                                fileInput.value = '';
                                return;
                            }

                            const formData =
                                new FormData();

