                                            'ai-video-meta';

                                        medicalRecord.textContent =
                                            '病歷號：'
                                            + item.medicalRecordNumber;

                                        card.appendChild(
                                            medicalRecord
                                        );
                                    }


                                    if (item.note) {

                                        const note =
                                            document.createElement(
                                                'div'
                                            );

                                        note.className =
                                            'ai-video-note';

                                        note.textContent =
                                            item.note;

                                        card.appendChild(
