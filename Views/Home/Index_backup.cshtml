    </script>
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const openPanel =
                    "@(TempData["OpenPanel"]?.ToString() ?? "")";

                if (openPanel === "add") {
                    document.querySelectorAll(".panel")
                        .forEach(function(panel) {
                            panel.classList.remove("active");
                        });

                    document.querySelectorAll(".nav-item")
                        .forEach(function(item) {
                            item.classList.remove("active");
                        });

                    const addPanel =
                        document.getElementById("panel-add");

                    if (addPanel) {
                        addPanel.classList.add("active");
                    }

                    const addNav =
                        document.querySelector(
                            '.nav-item[onclick*="panel-add"]'
                        );

                    if (addNav) {
                        addNav.classList.add("active");
                    }

                    const message =
                        document.getElementById(
                            "serverValidationMessage"
                        );

                    if (message) {
                        message.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });
                    }
                }

                const fileInput =
                    document.getElementById(
                        'medical-record-file'
                    );

                const fileNameElement =
                    document.getElementById(
                        'medical-record-file-name'
                    );

                if (fileInput && fileNameElement) {
                    fileInput.addEventListener(
                        'change',
                        function() {
                            const file =
                                this.files &&
                                    this.files.length > 0
                                    ? this.files[0]
                                    : null;

                            fileNameElement.textContent =
                                file
                                    ? file.name
                                    : '選擇病歷檔案';
                        }
                    );
                }
                const paperFileInput =
                    document.getElementById(
                        'paper-medical-record-file'
                    );

                const paperFileNameElement =
                    document.getElementById(
                        'paper-medical-record-file-name'
                    );

                if (paperFileInput && paperFileNameElement) {
                    paperFileInput.addEventListener(
                        'change',
                        function() {
                            const file =
                                this.files &&
                                    this.files.length > 0
                                    ? this.files[0]
                                    : null;

                            paperFileNameElement.textContent =
                                file
                                    ? file.name
                                    : '選擇紙本病歷圖片';

                            // 清除上一張圖片的辨識結果
                            recognizedPaperMedicalRecord = null;
                            const paperEditForm =
                                document.getElementById(
                                    'paper-medical-record-edit-form'
                                );

                            if (paperEditForm) {
                                paperEditForm.style.display = 'none';
                            }

                            [
                                'paper-row',
                                'paper-medical-record-number',
                                'paper-patient-name',
                                'paper-record-date',
                                'paper-record-time',
                                'paper-symptoms',
                                'paper-assessment',
                                'paper-treatment',
                                'paper-nursing-note',
                                'paper-blood-pressure',
                                'paper-pulse',
                                'paper-respiratory-rate',
                                'paper-temperature',
                                'paper-oxygen-saturation',
                                'paper-body-weight',
                                'paper-medications',
                                'paper-lab-findings',
                                'paper-raw-text'
                            ].forEach(function(id) {
                                const element =
                                    document.getElementById(id);

                                if (element) {
                                    element.value = '';
                                }
                            });
                            // 重新停用「確認匯入」
                            const importButton =
                                document.getElementById(
                                    'paper-medical-record-import-button'
                                );

                            if (importButton) {
                                importButton.disabled = true;
                            }

                            // 清除上一張圖片的辨識預覽
                            const previewElement =
                                document.getElementById(
                                    'paper-medical-record-preview'
                                );

                            if (previewElement) {
                                previewElement.textContent = '';
                                previewElement.classList.remove('open');
                            }

                            // 更新提示文字
                            const statusElement =
                                document.getElementById(
                                    'paper-medical-record-status'
                                );

                            if (statusElement) {
                                statusElement.textContent =
                                    file
                                        ? '圖片已選擇，請按「AI 辨識」。'
                                        : '請選擇紙本病歷照片後進行 AI 辨識。';

                                statusElement.className =
                                    'ai-record-status';
                            }
                        }
                    );
                }

                const questionInput =
                    document.getElementById('ai-question');

                if (questionInput) {
                    questionInput.addEventListener(
                        'input',
                        function() {
                            this.style.height = 'auto';

                            this.style.height =
                                Math.min(
                                    this.scrollHeight,
                                    180
                                ) + 'px';
                        }
                    );

                    questionInput.addEventListener(
                        'keydown',
                        function(event) {
                            if (
                                event.key === 'Enter' &&
                                !event.shiftKey
                            ) {
                                event.preventDefault();
                                askAi();
                            }
                        }
                    );
                }
                restoreAiChatState();
            });

            function hideAiWelcome() {
                const welcome =
                    document.getElementById('ai-welcome');

                if (welcome) {
                    welcome.remove();
                }
            }

                        function useAiPrompt(text) {
                const input =
                    document.getElementById('ai-question');

                if (!input) {
                    return;
                }

                input.value = text;
                input.focus();

                // 建議主題標記
                askAi({
                    suggestedTopic: true
                });
            }

            function openNewAiChat() {
                const navAi =
                    document.getElementById('nav-ai');

                const panelAi =
                    document.getElementById('panel-ai');

                if (!navAi || !panelAi) {
                    return;
                }

                clearAiChat();

                showPanel(
                    'panel-ai',
                    navAi
                );
            }

            function toggleSidebar() {
                const sidebar =
                    document.querySelector('.sidebar');

                const overlay =
                    document.getElementById(
                        'sidebar-overlay'
                    );

                if (!sidebar || !overlay) {
                    console.error(
                        '找不到側邊欄或遮罩元素。'
                    );

                    return;
                }

                const willOpen =
                    !sidebar.classList.contains('open');

                sidebar.classList.toggle(
                    'open',
                    willOpen
                );

                overlay.classList.toggle(
                    'open',
                    willOpen
                );

                document.body.classList.toggle(
                    'sidebar-open',
                    willOpen
                );
            }

            function closeSidebar() {
                document.querySelector('.sidebar')
                    ?.classList.remove('open');

                document.getElementById(
                    'sidebar-overlay'
                )?.classList.remove('open');

                document.body.classList.remove(
                    'sidebar-open'
                );
            }

            document.addEventListener(
                'keydown',
                function(event) {
                    if (event.key === 'Escape') {
                        closeSidebar();
                    }
                }
            );
    </script>
