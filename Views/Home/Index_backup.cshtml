                        function appendAiImageGallery(
                            messageElement,
                            images
                        ) {
                            const gallery =
                                document.createElement(
                                    'div'
                                );

                            gallery.className =
                                'ai-image-gallery';

                            images.forEach(
                                function(item) {
                                    if (
                                        !item
                                        ||
                                        !item.imagePath
                                    ) {
                                        return;
                                    }

                                    const card =
                                        document.createElement(
                                            'div'
                                        );

                                    card.className =
                                        'ai-image-card';

                                    const link =
                                        document.createElement(
                                            'a'
                                        );

                                    link.href =
                                        item.pageUrl || '#';

                                    link.title =
                                        '前往病人 '
                                        + (item.patientRowKey || '')
                                        + ' 的病理影像';

                                    const image =
                                        document.createElement(
                                            'img'
                                        );

                                    image.className =
                                        'ai-result-image';

                                    image.src =
                                        item.imagePath;

                                    image.alt =
                                        item.title
                                        || '病歷影像';

                                    image.loading =
                                        'lazy';

                                    link.appendChild(
                                        image
                                    );

                                    card.appendChild(
                                        link
                                    );

                                    const meta =
                                        document.createElement(
                                            'div'
                                        );

                                    meta.className =
                                        'ai-image-meta';

                                    const title =
                                        document.createElement(
                                            'div'
                                        );

                                    title.className =
                                        'ai-image-title';

                                    title.textContent =
                                        item.title
                                        || '病歷影像';

                                    meta.appendChild(
                                        title
                                    );

                                    if (
                                        item.patientRowKey
                                    ) {
                                        const patient =
                                            document.createElement(
                                                'div'
                                            );

                                        patient.className =
                                            'ai-image-patient';

                                        patient.textContent =
                                            '病人編號：'
                                            +
                                            item.patientRowKey;

                                        meta.appendChild(
                                            patient
                                        );
                                    }
                                    if (item.medicalRecordNumber) {

                                        const medicalRecord =
                                            document.createElement(
                                                'div'
                                            );

                                        medicalRecord.className =
                                            'ai-image-patient';

                                        medicalRecord.textContent =
                                            '病歷號：'
                                            + item.medicalRecordNumber;

                                        meta.appendChild(
                                            medicalRecord
                                        );
                                    }
                                    if (item.note) {
                                        const note =
                                            document.createElement(
                                                'div'
                                            );

                                        note.className =
                                            'ai-image-note';

                                        note.textContent =
                                            item.note;

                                        meta.appendChild(
                                            note
                                        );
                                    }

                                    if (item.isAnnotated) {
                                        const badge =
                                            document.createElement(
                                                'span'
                                            );

                                        badge.className =
                                            'ai-image-badge';

                                        badge.textContent =
                                            '顯示標註後影像';

                                        meta.appendChild(
                                            badge
                                        );
                                    }

                                    card.appendChild(
                                        meta
                                    );

                                    gallery.appendChild(
                                        card
                                    );
                                }
                            );

                            if (
                                gallery.childElementCount
                                > 0
                            ) {
                                messageElement.appendChild(
                                    gallery
                                );
                            }
                        }
                        function appendAiPatientReferences(
                            messageElement,
                            patientReferences
                        ) {
                            const container =
                                document.createElement('div');

                            container.className =
                                'ai-patient-references';

                            patientReferences.forEach(
                                function(item) {

                                    if (!item) {
                                        return;
                                    }

                                    const card =
                                        document.createElement('div');

                                    card.className =
                                        'ai-patient-reference';

                                    const info =
                                        document.createElement('div');

                                    info.textContent =
                                        '病人編號：'
                                        + (item.patientRowKey || '')
                                        + (
                                            item.medicalRecordNumber
                                                ? '　病歷號：'
                                                + item.medicalRecordNumber
                                                : ''
                                        );

                                    card.appendChild(info);

                                    if (item.medicalRecordUrl) {

                                        const medicalLink =
                                            document.createElement('a');

                                        medicalLink.href =
                                            item.medicalRecordUrl;

                                        medicalLink.textContent =
                                            '查看病歷';

                                        medicalLink.className =
                                            'btn btn-sm';

                                        card.appendChild(
                                            medicalLink
                                        );
                                    }

                                    if (item.imageUrl) {

                                        const imageLink =
                                            document.createElement('a');

                                        imageLink.href =
                                            item.imageUrl;

                                        imageLink.textContent =
                                            '查看相關影像';

                                        imageLink.className =
                                            'btn btn-sm';

                                        card.appendChild(
                                            imageLink
                                        );
                                    }

                                    container.appendChild(
                                        card
                                    );
                                }
                            );

                            messageElement.appendChild(
                                container
                            );
                        }
 function clearAiChat() {
