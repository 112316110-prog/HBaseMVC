                                console.error('紙本病歷辨識介面缺少必要元素。');
                                return;
                            }

                            const file =
                                fileInput.files && fileInput.files.length > 0
                                    ? fileInput.files[0]
                                    : null;

                            if (!file) {
                                statusElement.textContent =
                                    '請先選擇紙本病歷圖片。';

                                statusElement.className =
                                    'ai-record-status error';

                                return;
                            }

                            const allowedExtensions = [
                                '.jpg',
                                '.jpeg',
                                '.png'
                            ];

                            const lowerFileName =
                                file.name.toLowerCase();

                            const isAllowed =
                                allowedExtensions.some(extension =>
                                    lowerFileName.endsWith(extension)
                                );

                            if (!isAllowed) {
                                statusElement.textContent =
                                    '目前只支援 JPG、JPEG、PNG 圖片。';

                                statusElement.className =
                                    'ai-record-status error';

                                return;
                            }

                            const maxFileSize =
                                15 * 1024 * 1024;

                            if (file.size > maxFileSize) {
                                statusElement.textContent =
                                    '圖片不可超過 15 MB。';

                                statusElement.className =
                                    'ai-record-status error';

                                return;
                            }

                            const formData =
                                new FormData();

                            formData.append(
                                'medicalRecordFile',
                                file
                            );
                            recognizedPaperMedicalRecord = null;
                            const editForm =
                                document.getElementById(
                                    'paper-medical-record-edit-form'
