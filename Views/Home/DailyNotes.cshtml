                    border-color: #969696;
                }

            .btn {
                min-height: 40px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 15px;
                border: 1px solid var(--border2);
                border-radius: 9px;
                background: white;
                color: var(--text);
                font: inherit;
                font-size: 13px;
                font-weight: 500;
                text-decoration: none;
                cursor: pointer;
            }

                .btn:hover {
                    background: #f1f1f1;
                }

            .btn-primary {
                border-color: #212121;
                background: #212121;
                color: white;
            }

                .btn-primary:hover {
                    background: #000;
                }

            .message.success {
                border-left: 4px solid #16a34a;
            }

            .message.error {
                border-left: 4px solid #dc2626;
            }

            .updated-at {
                margin-top: 8px;
                color: var(--text3);
                font-size: 12px;
            }

            .history-table {
                width: 100%;
                border-collapse: collapse;
            }

                .history-table th,
                .history-table td {
                    padding: 12px 10px;
                    border-bottom: 1px solid var(--border);
                    text-align: left;
                    vertical-align: top;
                }

                .history-table th {
                    background: #fafafa;
                    color: var(--text2);
                    font-size: 12px;
                    font-weight: 600;
                }

                .history-table td {
                    font-size: 13px;
                }

            .history-content {
                max-width: 620px;
                color: var(--text2);
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }

            .empty {
                padding: 30px;
                color: var(--text3);
                text-align: center;
            }

            @@media (max-width: 700px) {
                .page {
                    width: calc(100% - 28px);
                    padding-top: 18px;
                }

                .app-header {
                    padding: 0 14px;
                }

                .form-row {
                    align-items: stretch;
                    flex-direction: column;
                }

                .btn {
                    width: 100%;
                }
            }

            /* ===== 與 Index_backup.cshtml 相同的側邊欄樣式 ===== */
            :root {
                --sidebar-bg: #f7f7f8;
                --border: #e5e5e5;
