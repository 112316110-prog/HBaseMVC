        <div class="sidebar-spacer"></div>

        <div class="account-card">
            <div class="account-avatar">生</div>

            <div class="account-info">
                <div class="account-name">學生</div>
                <div class="account-id">@loginId</div>
            </div>

            <a class="account-logout"
               href="@Url.Action("Logout", "Home")">
                登出
            </a>
        </div>

    </nav>

    <div class="sidebar-overlay"
         id="sidebar-overlay"
         onclick="closeSidebar()">
    </div>

    <main class="main">

        <header class="app-header">

            <button type="button"
                    class="mobile-menu-button"
                    onclick="toggleSidebar()">
                ☰
            </button>

            <div class="app-header-title">
                課程筆記
            </div>

            <div class="app-header-spacer"></div>

            <a class="home-button"
               href="@Url.Action("Index", "Home")">
                ← 回首頁
            </a>

        </header>

        <div class="page">

            <div class="page-heading">
                <div class="page-title">
                    課程筆記
                </div>

                <div class="page-subtitle">
                    只能依照系統中已有手術安排的日期建立筆記；每位學生只會看到自己的筆記。
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                string messageType =
                    TempData["MessageType"]?.ToString()
                    ?? "success";

                <div class="card message @messageType">
                    @TempData["Message"]
                </div>
            }

            <div class="card">

                <div class="card-title">
                    編輯課程筆記
                </div>

                @if (Model.AvailableDates.Count == 0)
                {
                    <div class="empty">
                        目前尚未建立任何手術安排，
                        因此還不能建立課程筆記。
                    </div>
                }
                else
                {
                    <form method="get"
                          action="@Url.Action("DailyNotes", "Home")">

                        <div class="form-row">

                            <div class="field">
                                <label>
                                    手術日期
                                </label>

                                <select name="noteDate"
                                        required
                                        style="
                                    width:100%;
                                    height:40px;
                                    padding:0 11px;
                                    border:1px solid var(--border2);
                                    border-radius:9px;
                                    background:white;
                                    color:var(--text);
                                    font:inherit;">

                                    @foreach (
                                        var item
                                        in Model.AvailableDates)
                                    {
                                        if (item.Date ==
                                            Model.SelectedDate)
                                        {
                                            <option value="@item.Date"
                                                    selected>
                                                @item.DisplayText
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@item.Date">
                                                @item.DisplayText
                                            </option>
                                        }
                                    }

                                </select>
                            </div>

                            <button type="submit"
                                    class="btn">
                                開啟此日期
                            </button>

                        </div>

                    </form>
                }

                @if (Model.AvailableDates.Count > 0
                    &&
                    !string.IsNullOrWhiteSpace(
                        Model.SelectedDate))
                {
                    <!-- 新增筆記：獨立 form -->
                    <form method="post"
                          action="@Url.Action("SaveDailyNote", "Home")"
                          style="margin-top:18px;">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="noteDate"
                               value="@Model.SelectedDate" />

                        <label>新增筆記內容</label>

                        <textarea name="content"
                                  maxlength="10000"
                                  required
                                  placeholder="輸入新的課程筆記..."></textarea>

                        <div style="
                            margin-top:14px;
                            display:flex;
                            justify-content:flex-end;">

                            <button type="submit"
                                    class="btn btn-primary">
                                儲存課程筆記
                            </button>

                        </div>

                    </form>

                    <!-- 該日期的全部筆記：一定要放在新增 form 外面 -->
                    <div class="card"
                         style="margin-top:20px;">

                        <div class="card-title">
                            @Model.SelectedDate 的筆記紀錄
                        </div>

                        @if (selectedNotes.Count == 0)
                        {
                            <div style="
                                padding:20px 0;
                                color:#777;">
                                此日期目前沒有筆記。
                            </div>
                        }
                        else
                        {
                            @foreach (var note in selectedNotes)
                            {
                                <div style="
                                    border:1px solid #e5e5e5;
                                    border-radius:10px;
                                    padding:16px;
                                    margin-bottom:12px;
                                    background:#fff;">

                                    <div style="
                                        display:flex;
                                        justify-content:space-between;
                                        align-items:flex-start;
                                        gap:20px;">

                                        <div style="flex:1;">

                                            <div style="
                                                font-size:12px;
                                                color:#888;
                                                margin-bottom:8px;">
                                                紀錄時間：
                                                @(string.IsNullOrWhiteSpace(note.UpdatedAt)
                                                    ? "未記錄"
                                                    : note.UpdatedAt)
                                            </div>

                                            <div style="
                                                white-space:pre-wrap;
                                                word-break:break-word;
                                                line-height:1.8;">
                                                @note.Content
                                            </div>

                                        </div>

                                        <!-- 每一筆刪除都是獨立 form -->
                                        <form method="post"
                                              action="@Url.Action("DeleteDailyNote", "Home")"
                                              onsubmit="return confirm('確定刪除這筆筆記嗎？');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="rowKey"
                                                   value="@note.RowKey" />

                                            <input type="hidden"
                                                   name="noteDate"
                                                   value="@Model.SelectedDate" />

                                            <button type="submit"
                                                    style="
                                                border:1px solid #dc2626;
                                                background:#fff;
                                                color:#dc2626;
                                                border-radius:8px;
                                                padding:6px 12px;
                                                cursor:pointer;">
                                                刪除
                                            </button>

                                        </form>

                                    </div>

                                </div>
                            }
                        }

                    </div>
                }

            </div>

            <div class="card">

                <div class="card-title">
                    我的筆記紀錄
                </div>

                @if (Model.Notes.Count == 0)
                {
                    <div class="empty">
                        目前尚未建立課程筆記。
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto;">

                        <table class="history-table">

                            <thead>
                                <tr>
                                    <th style="width:140px;">日期</th>
                                    <th>筆記內容</th>
                                    <th style="width:170px;">最後修改</th>
                                    <th style="width:90px;">功能</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var note in Model.Notes)
                                {
                                    <tr>
                                        <td>@note.NoteDate</td>

                                        <td class="history-content">
                                            @note.Content
                                        </td>

                                        <td>
                                            @note.UpdatedAt
                                        </td>

                                        <td>
                                            <a class="btn"
                                               href="@Url.Action(
                                                                                                                                                 "DailyNotes",
                                                                                                                                                 "Home",
                                                                                                                                                 new
                                                                                                                                                 {
                                                                                                                                                     noteDate =
                                                                                                                                                         note.NoteDate
                                                                                                                                                 }
                                                                                                                                             )">
                                                開啟此日期
                                            </a>
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </main>

    <script>
            function toggleSidebar() {
                const sidebar =
                    document.getElementById(
                        'app-sidebar'
                    );

                const overlay =
                    document.getElementById(
                        'sidebar-overlay'
                    );

                if (!sidebar || !overlay)
                    return;

                const willOpen =
                    !sidebar.classList.contains(
                        'open'
                    );

                sidebar.classList.toggle(
                    'open',
                    willOpen
                );

                overlay.classList.toggle(
                    'open',
                    willOpen
                );

                document.body.classList.toggle(
                    'sidebar-open',
                    willOpen
                );
            }

            function closeSidebar() {
                document
                    .getElementById(
                        'app-sidebar'
                    )
                    ?.classList.remove('open');

                document
                    .getElementById(
                        'sidebar-overlay'
                    )
                    ?.classList.remove('open');

                document.body.classList.remove(
                    'sidebar-open'
                );
            }

            document.addEventListener(
                'keydown',
                function(event) {
                    if (event.key === 'Escape') {
                        closeSidebar();
                    }
                }
            );
    </script>

</body>

</html>