        </a>

        <a class="nav-item"
           href="@Url.Action("Index", "Home", new { panel = "ai" })"
           style="text-decoration:none;">
            <svg class="nav-icon"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 viewBox="0 0 24 24">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8.625 3.75a3.375 3.375 0 016.75 0v.75h.75a3.375 3.375 0 013.375 3.375v8.25a3.375 3.375 0 01-3.375 3.375h-8.25A3.375 3.375 0 014.5 16.125v-8.25A3.375 3.375 0 017.875 4.5h.75v-.75z" />
            </svg>
