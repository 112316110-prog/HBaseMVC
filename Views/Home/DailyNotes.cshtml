            }

            .sidebar-spacer {
                flex: 1;
            }

            .account-card {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 12px 8px 4px;
                margin-top: 14px;
                border-top: 1px solid var(--border);
            }

            .account-avatar {
                width: 34px;
                height: 34px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                background: #dedede;
                color: #333;
                font-size: 13px;
                font-weight: 600;
            }

            .account-info {
                flex: 1;
                min-width: 0;
            }

            .account-name {
                font-size: 13px;
                font-weight: 500;
            }

            .account-id {
                overflow: hidden;
                color: var(--text3);
                font-size: 11px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .account-logout {
                color: var(--text2);
                font-size: 12px;
                text-decoration: none;
            }

                .account-logout:hover {
                    color: var(--red);
                }

            .sidebar-overlay {
                position: fixed;
                inset: 0;
                z-index: 190;
                display: none;
                background: rgba(0,0,0,.28);
            }

                .sidebar-overlay.open {
                    display: block;
                }

            body.sidebar-open {
                overflow: hidden;
            }

    
            .new-chat-button {
                min-height: 42px;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 9px 11px;
                margin-bottom: 8px;
                border: 1px solid var(--border);
                border-radius: 9px;
                background: #ffffff;
                color: var(--text);
                font-size: 14px;
                text-decoration: none;
                cursor: pointer;
            }

                .new-chat-button:hover {
                    background: #ececec;
                }

            .new-chat-plus {
                font-size: 18px;
                line-height: 1;
            }

    </style>
</head>

<body>

