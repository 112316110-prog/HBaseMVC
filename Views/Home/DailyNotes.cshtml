@model HBaseMVC.Models.StudentDailyNotesViewModel
@using Microsoft.AspNetCore.Http

@{
    Layout = null;

    string role =
        Context.Session.GetString("Role") ?? "";

    bool isStudent =
        role == "Student";

    string loginId =
        Context.Session.GetString("LoginId") ?? "";

    var selectedNotes =
Model.Notes
    .Where(x =>
        string.Equals(
            x.NoteDate,
            Model.SelectedDate,
            StringComparison.OrdinalIgnoreCase
        )
    )
    .OrderByDescending(x =>
        DateTime.TryParse(
            x.UpdatedAt,
            out DateTime updatedAt
        )
            ? updatedAt
            : DateTime.MinValue
    )
    .ToList();
}

<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>課程筆記</title>

    <style>
            :root {
                --bg: #ffffff;
                --sidebar-bg: #f7f7f8;
                --input-bg: #f4f4f4;
                --border: #e5e5e5;
                --border2: #d4d4d4;
                --text: #212121;
                --text2: #676767;
                --text3: #969696;
                --accent: #10a37f;
                --sidebar-width: 260px;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--bg);
                color: var(--text);
                font-family: "Noto Sans TC", "Microsoft JhengHei", Arial, sans-serif;
            }

            .sidebar {
                position: fixed;
                top: 0;
                left: calc(var(--sidebar-width) * -1);
                z-index: 200;
                width: var(--sidebar-width);
                height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 12px;
                background: var(--sidebar-bg);
                border-right: 1px solid var(--border);
                overflow-y: auto;
                transition: left .22s ease, box-shadow .22s ease;
            }

                .sidebar.open {
                    left: 0;
                    box-shadow: 8px 0 30px rgba(0,0,0,.12);
                }

            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 8px 8px 18px;
            }

            .brand-icon {
                width: 36px;
                height: 36px;
                display: grid;
                place-items: center;
                border-radius: 10px;
                background: var(--accent);
                color: white;
                font-size: 18px;
                font-weight: 600;
            }

            .brand-title {
                font-size: 14px;
                font-weight: 600;
            }

            .brand-subtitle {
                margin-top: 1px;
                color: var(--text3);
                font-size: 11px;
            }

            .sidebar-section {
                padding: 18px 10px 7px;
                color: var(--text3);
                font-size: 11px;
                font-weight: 500;
                letter-spacing: .8px;
            }

            .nav-item {
                min-height: 42px;
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 9px 11px;
                margin-bottom: 2px;
                border-radius: 9px;
                color: var(--text);
                font-size: 14px;
                text-decoration: none;
            }

                .nav-item:hover {
                    background: #ececec;
                }

                .nav-item.active {
                    background: #e7e7e7;
                }

            .nav-icon {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
            }

            .sidebar-spacer {
                flex: 1;
            }

            .account-card {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 12px 8px 4px;
                margin-top: 14px;
                border-top: 1px solid var(--border);
            }

            .account-avatar {
                width: 34px;
                height: 34px;
                display: grid;
                place-items: center;
                border-radius: 50%;
                background: #dedede;
                font-size: 13px;
                font-weight: 600;
            }

            .account-info {
                flex: 1;
                min-width: 0;
            }

            .account-name {
                font-size: 13px;
                font-weight: 500;
            }

            .account-id {
                overflow: hidden;
                color: var(--text3);
                font-size: 11px;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .account-logout {
                color: var(--text2);
                font-size: 12px;
                text-decoration: none;
            }

            .sidebar-overlay {
                position: fixed;
                inset: 0;
                z-index: 190;
                display: none;
                background: rgba(0,0,0,.28);
            }

                .sidebar-overlay.open {
                    display: block;
                }

            body.sidebar-open {
                overflow: hidden;
            }

            .main {
                min-height: 100vh;
            }

            .app-header {
                position: sticky;
                top: 0;
                z-index: 50;
                height: 58px;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 22px;
                background: rgba(255,255,255,.92);
                border-bottom: 1px solid var(--border);
