@using Microsoft.AspNetCore.Http
@model List<HBaseMVC.Models.UserAccount>

@{
    Layout = null;

    ViewBag.Title =
        "學生帳號管理 — 病理教學系統";

    string loginId =
        Context.Session.GetString("LoginId")
        ?? "";
}

<!DOCTYPE html>

<html lang="zh-TW">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewBag.Title
    </title>

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: #ffffff;
                color: #212121;
                font-family: "Microsoft JhengHei", sans-serif;
            }

            .topbar {
                height: 72px;
                padding: 0 32px;
                background: #ffffff;
                border-bottom: 1px solid #e5e5e5;
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .topbar-title {
                font-size: 26px;
                font-weight: 700;
                color: #212121;
            }

            .topbar-space {
                flex: 1;
            }

            .admin-info {
                color: #6b7280;
                font-size: 14px;
            }

            .back-link {
                height: 38px;
                padding: 0 16px;
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                color: #374151;
                background: #ffffff;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
            }

                .back-link:hover {
                    background: #f1f1f1;
                    border-color: #c7c7c7;
                    color: #212121;
                }

            .page {
                max-width: 1000px;
                margin: 0 auto;
                padding: 32px 24px 60px;
            }

            .page-header {
                margin-bottom: 24px;
            }

            .page-title {
                margin: 0 0 6px;
                font-size: 30px;
                color: #1f2937;
            }

            .page-sub {
                margin: 0;
                color: #6b7280;
                font-size: 14px;
            }

            .alert {
                margin-bottom: 20px;
                padding: 12px 16px;
                border-radius: 7px;
                font-size: 14px;
            }

            .alert-success {
                color: #166534;
                background: #dcfce7;
                border: 1px solid #bbf7d0;
            }

            .alert-error {
                color: #991b1b;
                background: #fee2e2;
                border: 1px solid #fecaca;
            }

            .card {
                background: #ffffff;
                border: 1px solid #e5e5e5;
                border-radius: 16px;
                padding: 24px;
            }

            .card-title {
                margin: 0 0 5px;
                font-size: 21px;
                color: #212121;
            }

            .card-sub {
                margin: 0 0 22px;
                color: #6b7280;
                font-size: 13px;
            }

            .student-count {
                margin-left: 8px;
                color: #6b7280;
                font-size: 13px;
                font-weight: 400;
            }

            .student-list {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .student-item {
                padding: 16px;
                border: 1px solid #e5e5e5;
                border-radius: 10px;
                background: #f7f7f8;
            }

            .student-head {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .student-avatar {
                width: 42px;
                height: 42px;
                flex-shrink: 0;
                border-radius: 50%;
                background: #dcfce7;
                color: #166534;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .student-info {
                flex: 1;
            }

            .student-id {
                color: #111827;
                font-size: 17px;
                font-weight: 700;
            }

            .student-role {
                margin-top: 2px;
                color: #6b7280;
                font-size: 13px;
            }

            .student-actions {
                display: flex;
                gap: 8px;
            }

            .btn {
                height: 40px;
                padding: 0 16px;
                border: none;
                border-radius: 6px;
                font-family: inherit;
                font-size: 14px;
                cursor: pointer;
            }

            .btn-warning {
                color: #92400e;
                background: #fef3c7;
                border: 1px solid #fde68a;
            }

                .btn-warning:hover {
                    background: #fde68a;
                }

            .btn-danger {
                color: #991b1b;
                background: #fee2e2;
                border: 1px solid #fecaca;
            }

                .btn-danger:hover {
                    background: #fecaca;
                }

            .password-form {
                display: none;
                margin-top: 15px;
                padding-top: 15px;
                border-top: 1px solid #e5e5e5;
            }

                .password-form.open {
                    display: block;
                }

            .password-grid {
                display: grid;
                grid-template-columns: 1fr 1fr auto;
                gap: 8px;
                align-items: end;
            }

            .fg {
                margin-bottom: 0;
            }

                .fg label {
                    display: block;
                    margin-bottom: 6px;
                    color: #374151;
                    font-size: 14px;
                }

                .fg input {
                    width: 100%;
                    height: 40px;
                    padding: 0 11px;
                    border: 1px solid #d4d4d4;
                    border-radius: 9px;
                    background: #ffffff;
                    color: #212121;
                    font-size: 15px;
                    font-family: inherit;
                }

                    .fg input:focus {
                        outline: none;
                        border-color: #969696;
                    }

            .empty {
                padding: 50px 20px;
                color: #676767;
                text-align: center;
                border: 1px dashed #d4d4d4;
                border-radius: 10px;
                background: #f7f7f8;
            }

            .empty-title {
                margin-bottom: 5px;
                color: #212121;
                font-size: 17px;
                font-weight: 700;
            }

            @@media (max-width: 800px) {

                .password-grid {
                    grid-template-columns: 1fr;
                }

                .student-head {
                    align-items: flex-start;
                    flex-wrap: wrap;
                }

                .student-actions {
                    width: 100%;
                }
            }

            @@media (max-width: 600px) {

                .topbar {
                    height: auto;
                    padding: 15px;
                    flex-wrap: wrap;
                }

                .page {
                    padding: 22px 14px 40px;
                }
            }

    </style>

</head>

<body>

    <!-- =========================
         上方導覽列
         ========================= -->

    <header class="topbar">

        <div class="topbar-title">
            病理教學系統
        </div>

        <div class="topbar-space"></div>

        <div class="admin-info">
            管理員：@loginId
        </div>

        <a class="back-link"
           href="@Url.Action(
                          "SurgicalTableManagement",
                          "Home"
                      )">
            返回首頁
        </a>

    </header>


    <!-- =========================
         主要內容
         ========================= -->

    <main class="page">

        <div class="page-header">

            <h1 class="page-title">
                學生帳號管理
            </h1>

            <p class="page-sub">
                查看、修改密碼及刪除學生帳號
            </p>

        </div>


        <!-- =========================
             系統訊息
             ========================= -->
        @if (TempData["Message"] != null)
        {
            string messageType =
                TempData["MessageType"]?.ToString()
                ?? "error";

            <div class="alert @(messageType == "success"
                                ? "alert-success"
                                : "alert-error")">

                @TempData["Message"]

            </div>
        }


        <!-- =========================
             學生帳號清單
             ========================= -->

        <section class="card">

            <h2 class="card-title">

                學生帳號清單

                <span class="student-count">
                    @(Model?.Count ?? 0) 筆
                </span>

            </h2>

            <p class="card-sub">
                學生帳號由學生自行註冊；
                管理員可協助重設密碼或刪除帳號。
            </p>


            @if (
                Model == null ||
                Model.Count == 0
            )
            {
                <div class="empty">

                    <div class="empty-title">
                        尚無學生帳號
                    </div>

                    <div>
                        目前系統中沒有已註冊的學生帳號
                    </div>

                </div>
            }
            else
            {
                <div class="student-list">

                    @foreach (var student in Model)
                    {
                        string formId =
                            $"password-{student.LoginId}";

                        <div class="student-item">

                            <!-- =========================
                                 學生資料
                                 ========================= -->

                            <div class="student-head">

                                <div class="student-avatar">
                                    生
                                </div>

                                <div class="student-info">

                                    <div class="student-id">
                                        @student.LoginId
                                    </div>

                                    <div class="student-role">
                                        身分：學生
                                    </div>

                                </div>


                                <!-- =========================
                                     操作按鈕
                                     ========================= -->

                                <div class="student-actions">

                                    <button type="button"
                                            class="btn btn-warning"
                                            onclick="togglePasswordForm(
                                        '@formId'
                                        )">
                                        修改密碼
                                    </button>


                                    <form method="post"
                                          action="@Url.Action(
                                                                                      "DeleteStudentAccount",
                                                                                      "Home"
                                                                                  )"
                                          onsubmit="return confirm(
                                        '確定要刪除學生帳號「@student.LoginId」嗎？'
                                        );">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="loginId"
                                               value="@student.LoginId" />

                                        <button type="submit"
                                                class="btn btn-danger">
                                            刪除
                                        </button>

                                    </form>

                                </div>

                            </div>


                            <!-- =========================
                                 修改密碼表單
                                 ========================= -->

                            <div id="@formId"
                                 class="password-form">

                                <form method="post"
                                      action="@Url.Action(
                                                                              "ResetStudentPassword",
                                                                              "Home"
                                                                          )">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="loginId"
                                           value="@student.LoginId" />


                                    <div class="password-grid">

                                        <div class="fg">

                                            <label>
                                                新密碼
                                            </label>

                                            <input type="password"
                                                   name="newPassword"
                                                   minlength="8"
                                                   placeholder="至少 8 個字元"
                                                   autocomplete="new-password"
                                                   required />

                                        </div>


                                        <div class="fg">

                                            <label>
                                                確認新密碼
                                            </label>

                                            <input type="password"
                                                   name="confirmNewPassword"
                                                   minlength="8"
                                                   placeholder="再次輸入新密碼"
                                                   autocomplete="new-password"
                                                   required />

                                        </div>


                                        <button type="submit"
                                                class="btn btn-warning">
                                            儲存新密碼
                                        </button>

                                    </div>

                                </form>

                            </div>

                        </div>
                    }

                </div>
            }

        </section>

    </main>


    <!-- =========================
         Javascript
         ========================= -->

    <script>

            function togglePasswordForm(id) {

                const form =
                    document.getElementById(id);

                if (!form) {
                    return;
                }

                form.classList.toggle(
                    "open"
                );
            }

    </script>

</body>

</html>